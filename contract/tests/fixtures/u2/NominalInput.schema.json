{
  "$defs": {
    "Calibration": {
      "enum": [
        "measured",
        "spec_derived",
        "estimated",
        "stub"
      ],
      "title": "Calibration",
      "type": "string"
    },
    "DecodeQuery": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "minimum": 1,
          "title": "Batch",
          "type": "integer"
        },
        "phase": {
          "const": "decode",
          "title": "Phase",
          "type": "string"
        },
        "total_context_tokens": {
          "minimum": 1,
          "title": "Total Context Tokens",
          "type": "integer"
        }
      },
      "required": [
        "batch",
        "phase",
        "total_context_tokens"
      ],
      "title": "DecodeQuery",
      "type": "object"
    },
    "ExecutionModelInput": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "enum": [
            "proposed",
            "accepted_input"
          ],
          "title": "Acceptance",
          "type": "string"
        },
        "assumption_note": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Assumption Note",
          "type": "string"
        },
        "compute": {
          "$ref": "#/$defs/SourcedValue"
        },
        "evidence_hashes": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 0,
          "title": "Evidence Hashes",
          "type": "array"
        },
        "execution_model_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Model Hash",
          "type": "string"
        },
        "format": {
          "const": "uarch-execution-model/1",
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scalar_efficiency",
            "split_efficiency"
          ],
          "title": "Kind",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourcedValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "acceptance",
        "assumption_note",
        "compute",
        "evidence_hashes",
        "execution_model_hash",
        "format",
        "kind",
        "memory"
      ],
      "title": "ExecutionModelInput",
      "type": "object"
    },
    "ExplicitPrecision": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "kv_cache": {
          "$ref": "#/$defs/PrecisionFormat"
        }
      },
      "required": [
        "compute",
        "kv_cache"
      ],
      "title": "ExplicitPrecision",
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "name": {
          "enum": [
            "physical-resolved",
            "nominal-rk-compatibility"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "name",
        "version"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "ModelSpec": {
      "additionalProperties": false,
      "description": "MoE is active-vs-total and nothing more (build-spec \u00a72.3.5).",
      "properties": {
        "active_params": {
          "minimum": 1,
          "title": "Active Params",
          "type": "integer"
        },
        "d_model": {
          "minimum": 1,
          "title": "D Model",
          "type": "integer"
        },
        "experts_per_token": {
          "default": 0,
          "minimum": 0,
          "title": "Experts Per Token",
          "type": "integer"
        },
        "kv_heads": {
          "minimum": 1,
          "title": "Kv Heads",
          "type": "integer"
        },
        "n_experts": {
          "default": 0,
          "minimum": 0,
          "title": "N Experts",
          "type": "integer"
        },
        "n_heads": {
          "minimum": 1,
          "title": "N Heads",
          "type": "integer"
        },
        "n_layers": {
          "minimum": 1,
          "title": "N Layers",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "total_params": {
          "minimum": 1,
          "title": "Total Params",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "total_params",
        "active_params",
        "n_layers",
        "d_model",
        "n_heads",
        "kv_heads"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "PrefillQuery": {
      "additionalProperties": false,
      "properties": {
        "n_prompts": {
          "minimum": 1,
          "title": "N Prompts",
          "type": "integer"
        },
        "phase": {
          "const": "prefill",
          "title": "Phase",
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 1,
          "title": "Prompt Tokens",
          "type": "integer"
        }
      },
      "required": [
        "n_prompts",
        "phase",
        "prompt_tokens"
      ],
      "title": "PrefillQuery",
      "type": "object"
    },
    "SourcedValue": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "kind": {
          "default": "claim",
          "enum": [
            "claim",
            "stipulation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Calibration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "SourcedValue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bandwidth": {
      "$ref": "#/$defs/SourcedValue"
    },
    "component_binding_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Component Binding Hash",
      "type": "string"
    },
    "execution_model": {
      "$ref": "#/$defs/ExecutionModelInput"
    },
    "format": {
      "const": "uarch-nominal-input/1",
      "title": "Format",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelSpec"
    },
    "model_identity": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "precision": {
      "$ref": "#/$defs/ExplicitPrecision"
    },
    "query": {
      "discriminator": {
        "mapping": {
          "decode": "#/$defs/DecodeQuery",
          "prefill": "#/$defs/PrefillQuery"
        },
        "propertyName": "phase"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DecodeQuery"
        },
        {
          "$ref": "#/$defs/PrefillQuery"
        }
      ],
      "title": "Query"
    },
    "selected_peak": {
      "$ref": "#/$defs/SourcedValue"
    },
    "tp": {
      "minimum": 1,
      "title": "Tp",
      "type": "integer"
    }
  },
  "required": [
    "bandwidth",
    "component_binding_hash",
    "execution_model",
    "format",
    "input_hash",
    "model",
    "model_identity",
    "precision",
    "query",
    "selected_peak",
    "tp"
  ],
  "title": "NominalInput",
  "type": "object"
}
