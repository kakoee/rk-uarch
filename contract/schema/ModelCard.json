{
  "$defs": {
    "ApplicabilityScope": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Family",
          "type": "string"
        },
        "load_regimes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Load Regimes",
          "type": "array"
        },
        "mapping_match": {
          "enum": [
            "matched",
            "compiler-chosen"
          ],
          "title": "Mapping Match",
          "type": "string"
        },
        "op_classes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Op Classes",
          "type": "array"
        },
        "precisions": {
          "items": {
            "$ref": "#/$defs/PrecisionFormat"
          },
          "title": "Precisions",
          "type": "array"
        },
        "shape_regimes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Shape Regimes",
          "type": "array"
        }
      },
      "required": [
        "family",
        "op_classes",
        "precisions",
        "shape_regimes",
        "load_regimes",
        "mapping_match"
      ],
      "title": "ApplicabilityScope",
      "type": "object"
    },
    "EnergyVerification": {
      "additionalProperties": false,
      "properties": {
        "L0": {
          "additionalProperties": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "mac",
              "sram",
              "noc_hop",
              "dram",
              "static"
            ]
          },
          "title": "L0",
          "type": "object"
        },
        "L2": {
          "additionalProperties": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "mac",
              "sram",
              "noc_hop",
              "dram",
              "static"
            ]
          },
          "title": "L2",
          "type": "object"
        }
      },
      "required": [
        "L0",
        "L2"
      ],
      "title": "EnergyVerification",
      "type": "object"
    },
    "FidelityDetail": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Compute",
          "type": "integer"
        },
        "dram": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Dram"
        },
        "layer_reuse": {
          "title": "Layer Reuse",
          "type": "boolean"
        },
        "noc": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Noc"
        },
        "shared_sram": {
          "description": "Omit only when hardware has no shared SRAM; null is invalid.",
          "enum": [
            0,
            1,
            "1+ts",
            "unrepresented"
          ],
          "title": "Shared Sram"
        },
        "sync": {
          "pattern": "^(exact|approx\\(Q=[1-9][0-9]*\\))$",
          "title": "Sync",
          "type": "string"
        }
      },
      "required": [
        "compute",
        "noc",
        "dram",
        "sync",
        "layer_reuse"
      ],
      "title": "FidelityDetail",
      "type": "object"
    },
    "ModelId": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Engine Version",
          "type": "string"
        },
        "fidelity_detail": {
          "$ref": "#/$defs/FidelityDetail"
        },
        "mapping_policy": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Mapping Policy",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "engine_version",
        "fidelity_detail",
        "mapping_policy"
      ],
      "title": "ModelId",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "ValidatedErrorBand": {
      "additionalProperties": false,
      "properties": {
        "high_rel": {
          "exclusiveMinimum": 0,
          "title": "High Rel",
          "type": "number"
        },
        "low_rel": {
          "minimum": 0,
          "title": "Low Rel",
          "type": "number"
        },
        "scope": {
          "$ref": "#/$defs/ApplicabilityScope"
        }
      },
      "required": [
        "low_rel",
        "high_rel",
        "scope"
      ],
      "title": "ValidatedErrorBand",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "L0": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "L0"
        },
        "L0m": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "L0M"
        },
        "L1": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "L1"
        },
        "L2": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "L2"
        }
      },
      "title": "Verification",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "badge": {
      "enum": [
        "stub",
        "estimated",
        "measured"
      ],
      "title": "Badge",
      "type": "string"
    },
    "energy_verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnergyVerification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "model_id": {
      "$ref": "#/$defs/ModelId"
    },
    "validated_error_band": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidatedErrorBand"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "model_id",
    "badge",
    "evidence",
    "verification"
  ],
  "title": "ModelCard",
  "type": "object"
}
