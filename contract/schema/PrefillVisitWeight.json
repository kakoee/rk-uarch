{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "n_prompts": {
      "minimum": 1,
      "title": "N Prompts",
      "type": "integer"
    },
    "prompt_tokens": {
      "minimum": 1,
      "title": "Prompt Tokens",
      "type": "integer"
    },
    "weight_ratio": {
      "exclusiveMinimum": 0,
      "title": "Weight Ratio",
      "type": "number"
    }
  },
  "required": [
    "n_prompts",
    "prompt_tokens",
    "weight_ratio"
  ],
  "title": "PrefillVisitWeight",
  "type": "object"
}
