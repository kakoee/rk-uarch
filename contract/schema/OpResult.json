{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "matrix_ops": {
          "minimum": 0,
          "title": "Matrix Ops",
          "type": "number"
        },
        "memory_read_bytes": {
          "minimum": 0,
          "title": "Memory Read Bytes",
          "type": "number"
        },
        "memory_write_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Write Bytes"
        },
        "vector_ops": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vector Ops"
        }
      },
      "required": [
        "matrix_ops",
        "vector_ops",
        "memory_read_bytes",
        "memory_write_bytes"
      ],
      "title": "Counts",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "ReportScope": {
      "additionalProperties": false,
      "properties": {
        "array_fill": {
          "anyOf": [
            {
              "enum": [
                "underfilled",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Array Fill"
        },
        "dram_load_regime": {
          "anyOf": [
            {
              "enum": [
                "low",
                "middle",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dram Load Regime"
        },
        "intensity_regime": {
          "anyOf": [
            {
              "enum": [
                "low",
                "middle",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Intensity Regime"
        },
        "mapping_match": {
          "anyOf": [
            {
              "enum": [
                "matched",
                "compiler-chosen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mapping Match"
        },
        "noc_load_regime": {
          "anyOf": [
            {
              "enum": [
                "low",
                "middle",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Noc Load Regime"
        },
        "op_class": {
          "minLength": 1,
          "title": "Op Class",
          "type": "string"
        },
        "precision_roles": {
          "$ref": "#/$defs/ReportScopePrecisionRoles"
        }
      },
      "required": [
        "array_fill",
        "dram_load_regime",
        "intensity_regime",
        "mapping_match",
        "noc_load_regime",
        "op_class",
        "precision_roles"
      ],
      "title": "ReportScope",
      "type": "object"
    },
    "ReportScopePrecisionRoles": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "kv_cache": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "operands": {
          "additionalProperties": {
            "$ref": "#/$defs/PrecisionFormat"
          },
          "title": "Operands",
          "type": "object"
        }
      },
      "required": [
        "compute",
        "kv_cache",
        "operands"
      ],
      "title": "ReportScopePrecisionRoles",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "achieved_ops_per_s": {
      "anyOf": [
        {
          "ge": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Achieved Ops Per S"
    },
    "bound": {
      "enum": [
        "compute",
        "memory"
      ],
      "title": "Bound",
      "type": "string"
    },
    "compute_time_ps": {
      "ge": 0,
      "title": "Compute Time Ps",
      "type": "number"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "dram_bw_bytes_per_s": {
      "gt": 0,
      "title": "Dram Bw Bytes Per S",
      "type": "number"
    },
    "duration_ps": {
      "ge": 0,
      "title": "Duration Ps",
      "type": "number"
    },
    "group_id": {
      "minLength": 1,
      "title": "Group Id",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "instances": {
      "minimum": 1,
      "title": "Instances",
      "type": "integer"
    },
    "matrix_peak_ops_per_s": {
      "gt": 0,
      "title": "Matrix Peak Ops Per S",
      "type": "number"
    },
    "memory_time_ps": {
      "ge": 0,
      "title": "Memory Time Ps",
      "type": "number"
    },
    "operational_intensity_ops_per_byte": {
      "anyOf": [
        {
          "ge": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Operational Intensity Ops Per Byte"
    },
    "ridge_ops_per_byte": {
      "gt": 0,
      "title": "Ridge Ops Per Byte",
      "type": "number"
    },
    "scope": {
      "$ref": "#/$defs/ReportScope"
    },
    "vector_peak_ops_per_s": {
      "gt": 0,
      "title": "Vector Peak Ops Per S",
      "type": "number"
    }
  },
  "required": [
    "achieved_ops_per_s",
    "bound",
    "compute_time_ps",
    "counts",
    "dram_bw_bytes_per_s",
    "duration_ps",
    "group_id",
    "id",
    "instances",
    "matrix_peak_ops_per_s",
    "memory_time_ps",
    "operational_intensity_ops_per_byte",
    "ridge_ops_per_byte",
    "scope",
    "vector_peak_ops_per_s"
  ],
  "title": "OpResult",
  "type": "object"
}
