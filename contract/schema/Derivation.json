{
  "$defs": {
    "Calibration": {
      "enum": [
        "measured",
        "spec_derived",
        "estimated",
        "stub"
      ],
      "title": "Calibration",
      "type": "string"
    },
    "DerivedParameter": {
      "additionalProperties": false,
      "properties": {
        "claim_badge": {
          "anyOf": [
            {
              "enum": [
                "measured",
                "spec_derived",
                "estimated",
                "stub"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Claim Badge"
        },
        "conditional_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Conditional Paths",
          "type": "array"
        },
        "contributor_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Contributor Paths",
          "type": "array"
        },
        "formula_id": {
          "minLength": 1,
          "title": "Formula Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "claim_badge",
        "conditional_paths",
        "contributor_paths",
        "formula_id",
        "name",
        "value"
      ],
      "title": "DerivedParameter",
      "type": "object"
    },
    "SourcedValue": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "kind": {
          "default": "claim",
          "enum": [
            "claim",
            "stipulation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Calibration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "SourcedValue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "derivation_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Derivation Hash",
      "type": "string"
    },
    "format": {
      "const": "uarch-derivation/1",
      "title": "Format",
      "type": "string"
    },
    "hardware_spec_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Hardware Spec Hash",
      "type": "string"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/DerivedParameter"
      },
      "minItems": 1,
      "title": "Parameters",
      "type": "array"
    }
  },
  "required": [
    "derivation_hash",
    "format",
    "hardware_spec_hash",
    "parameters"
  ],
  "title": "Derivation",
  "type": "object"
}
