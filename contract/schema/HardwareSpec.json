{
  "$defs": {
    "Calibration": {
      "enum": [
        "measured",
        "spec_derived",
        "estimated",
        "stub"
      ],
      "title": "Calibration",
      "type": "string"
    },
    "ClockDomain": {
      "additionalProperties": false,
      "properties": {
        "freq_hz": {
          "$ref": "#/$defs/SourcedValue"
        },
        "scales_with_core": {
          "title": "Scales With Core",
          "type": "boolean"
        }
      },
      "required": [
        "freq_hz",
        "scales_with_core"
      ],
      "title": "ClockDomain",
      "type": "object"
    },
    "ClockDomains": {
      "additionalProperties": false,
      "properties": {
        "core": {
          "$ref": "#/$defs/CoreClockDomain"
        },
        "dram": {
          "$ref": "#/$defs/ClockDomain"
        },
        "noc": {
          "$ref": "#/$defs/ClockDomain"
        }
      },
      "required": [
        "core",
        "noc",
        "dram"
      ],
      "title": "ClockDomains",
      "type": "object"
    },
    "Controller": {
      "additionalProperties": false,
      "properties": {
        "attach": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Attach",
          "type": "array"
        },
        "noc_credits": {
          "$ref": "#/$defs/SourcedValue"
        },
        "page_policy": {
          "enum": [
            "open",
            "closed"
          ],
          "title": "Page Policy",
          "type": "string"
        },
        "read_queue_depth": {
          "$ref": "#/$defs/SourcedValue"
        },
        "scheduler": {
          "enum": [
            "fr_fcfs",
            "fcfs"
          ],
          "title": "Scheduler",
          "type": "string"
        },
        "write_queue_depth": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "attach",
        "scheduler",
        "page_policy",
        "read_queue_depth",
        "write_queue_depth",
        "noc_credits"
      ],
      "title": "Controller",
      "type": "object"
    },
    "CoreClockDomain": {
      "additionalProperties": false,
      "properties": {
        "freq_hz": {
          "$ref": "#/$defs/SourcedValue"
        },
        "scales_with_core": {
          "const": true,
          "default": true,
          "title": "Scales With Core",
          "type": "boolean"
        }
      },
      "required": [
        "freq_hz"
      ],
      "title": "CoreClockDomain",
      "type": "object"
    },
    "CoreType": {
      "additionalProperties": false,
      "properties": {
        "dma": {
          "$ref": "#/$defs/Dma"
        },
        "job_overhead_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "matrix_engine": {
          "$ref": "#/$defs/MatrixEngine"
        },
        "sram": {
          "$ref": "#/$defs/Sram"
        },
        "vector_engine": {
          "$ref": "#/$defs/VectorEngine"
        }
      },
      "required": [
        "matrix_engine",
        "vector_engine",
        "sram",
        "dma",
        "job_overhead_cycles"
      ],
      "title": "CoreType",
      "type": "object"
    },
    "Cores": {
      "additionalProperties": false,
      "properties": {
        "core_type": {
          "$ref": "#/$defs/CoreType"
        },
        "grid": {
          "$ref": "#/$defs/HardwareGrid"
        }
      },
      "required": [
        "grid",
        "core_type"
      ],
      "title": "Cores",
      "type": "object"
    },
    "Dma": {
      "additionalProperties": false,
      "properties": {
        "bytes_per_cycle": {
          "$ref": "#/$defs/SourcedValue"
        },
        "engines": {
          "$ref": "#/$defs/SourcedValue"
        },
        "max_outstanding": {
          "$ref": "#/$defs/SourcedValue"
        },
        "request_bytes": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "engines",
        "bytes_per_cycle",
        "max_outstanding",
        "request_bytes"
      ],
      "title": "Dma",
      "type": "object"
    },
    "Dram": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "timing_source": {
                "const": "direct"
              }
            }
          },
          "then": {
            "properties": {
              "timing_preset": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timing_source": {
                "const": "preset"
              }
            }
          },
          "then": {
            "properties": {
              "timing_preset": {
                "type": "object"
              }
            },
            "required": [
              "timing_preset"
            ]
          }
        }
      ],
      "description": "Explicit timing origin; source strings are citations, never mode selectors.",
      "properties": {
        "bw_bytes_per_s": {
          "$ref": "#/$defs/SourcedValue"
        },
        "capacity_bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "channels": {
          "$ref": "#/$defs/SourcedValue"
        },
        "organization": {
          "$ref": "#/$defs/DramOrganization"
        },
        "standard": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Standard",
          "type": "string"
        },
        "timing": {
          "$ref": "#/$defs/DramTiming"
        },
        "timing_preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimingPreset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timing_source": {
          "enum": [
            "direct",
            "preset"
          ],
          "title": "Timing Source",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "channels",
        "bw_bytes_per_s",
        "capacity_bytes",
        "organization",
        "timing_source",
        "timing"
      ],
      "title": "Dram",
      "type": "object"
    },
    "DramOrganization": {
      "additionalProperties": false,
      "properties": {
        "bank_groups": {
          "$ref": "#/$defs/SourcedValue"
        },
        "banks_per_group": {
          "$ref": "#/$defs/SourcedValue"
        },
        "ranks": {
          "$ref": "#/$defs/SourcedValue"
        },
        "row_bytes": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "ranks",
        "bank_groups",
        "banks_per_group",
        "row_bytes"
      ],
      "title": "DramOrganization",
      "type": "object"
    },
    "DramTiming": {
      "additionalProperties": false,
      "properties": {
        "t_cl_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "t_rcd_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "t_refi_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "t_rfc_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "t_rp_cycles": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "t_rcd_cycles",
        "t_rp_cycles",
        "t_cl_cycles",
        "t_rfc_cycles",
        "t_refi_cycles"
      ],
      "title": "DramTiming",
      "type": "object"
    },
    "Energy": {
      "additionalProperties": false,
      "properties": {
        "pj_per_byte": {
          "additionalProperties": {
            "$ref": "#/$defs/SourcedValue"
          },
          "propertyNames": {
            "enum": [
              "sram",
              "noc_hop",
              "dram"
            ]
          },
          "title": "Pj Per Byte",
          "type": "object"
        },
        "pj_per_mac": {
          "additionalProperties": {
            "$ref": "#/$defs/SourcedValue"
          },
          "propertyNames": {
            "$ref": "#/$defs/PrecisionFormat"
          },
          "title": "Pj Per Mac",
          "type": "object"
        },
        "voltage_ratio": {
          "additionalProperties": {
            "$ref": "#/$defs/SourcedValue"
          },
          "title": "Voltage Ratio",
          "type": "object"
        }
      },
      "required": [
        "pj_per_mac",
        "pj_per_byte",
        "voltage_ratio"
      ],
      "title": "Energy",
      "type": "object"
    },
    "HardwareGrid": {
      "additionalProperties": false,
      "properties": {
        "cols": {
          "$ref": "#/$defs/SourcedValue"
        },
        "rows": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "rows",
        "cols"
      ],
      "title": "HardwareGrid",
      "type": "object"
    },
    "Interleave": {
      "additionalProperties": false,
      "properties": {
        "granularity_bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "scheme": {
          "enum": [
            "channel_hash",
            "round_robin"
          ],
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "granularity_bytes",
        "scheme"
      ],
      "title": "Interleave",
      "type": "object"
    },
    "MatrixEngine": {
      "additionalProperties": false,
      "properties": {
        "accumulator_bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "array": {
          "$ref": "#/$defs/HardwareGrid"
        },
        "dataflows": {
          "items": {
            "enum": [
              "weight_stationary",
              "output_stationary"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataflows",
          "type": "array"
        },
        "macs_per_cycle": {
          "additionalProperties": {
            "$ref": "#/$defs/SourcedValue"
          },
          "propertyNames": {
            "$ref": "#/$defs/PrecisionFormat"
          },
          "title": "Macs Per Cycle",
          "type": "object"
        },
        "operand_buffer_bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "operand_bytes_per_cycle": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "array",
        "dataflows",
        "macs_per_cycle",
        "accumulator_bytes",
        "operand_buffer_bytes",
        "operand_bytes_per_cycle"
      ],
      "title": "MatrixEngine",
      "type": "object"
    },
    "Memory": {
      "additionalProperties": false,
      "properties": {
        "controllers": {
          "items": {
            "$ref": "#/$defs/Controller"
          },
          "minItems": 1,
          "title": "Controllers",
          "type": "array"
        },
        "dram": {
          "$ref": "#/$defs/Dram"
        },
        "interleave": {
          "$ref": "#/$defs/Interleave"
        }
      },
      "required": [
        "interleave",
        "controllers",
        "dram"
      ],
      "title": "Memory",
      "type": "object"
    },
    "Noc": {
      "additionalProperties": false,
      "properties": {
        "buffer_flits": {
          "$ref": "#/$defs/SourcedValue"
        },
        "direction": {
          "enum": [
            "positive",
            "negative",
            "bidirectional"
          ],
          "title": "Direction",
          "type": "string"
        },
        "link_bytes_per_cycle": {
          "$ref": "#/$defs/SourcedValue"
        },
        "router_latency_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "topology": {
          "enum": [
            "mesh",
            "torus"
          ],
          "title": "Topology",
          "type": "string"
        },
        "virtual_channels": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "topology",
        "direction",
        "link_bytes_per_cycle",
        "router_latency_cycles",
        "virtual_channels",
        "buffer_flits"
      ],
      "title": "Noc",
      "type": "object"
    },
    "NumericFormat": {
      "additionalProperties": false,
      "properties": {
        "accumulate_bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "block_scale_bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "number"
        }
      },
      "required": [
        "bytes",
        "accumulate_bytes",
        "block_scale_bytes"
      ],
      "title": "NumericFormat",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "SharedSram": {
      "additionalProperties": false,
      "properties": {
        "attach": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Attach",
          "type": "array"
        },
        "banks": {
          "$ref": "#/$defs/SourcedValue"
        },
        "bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "bytes_per_cycle_per_bank": {
          "$ref": "#/$defs/SourcedValue"
        },
        "latency_cycles": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "bytes",
        "banks",
        "bytes_per_cycle_per_bank",
        "latency_cycles",
        "attach"
      ],
      "title": "SharedSram",
      "type": "object"
    },
    "SourcedValue": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "kind": {
          "default": "claim",
          "enum": [
            "claim",
            "stipulation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Calibration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "SourcedValue",
      "type": "object"
    },
    "Sram": {
      "additionalProperties": false,
      "properties": {
        "banks": {
          "$ref": "#/$defs/SourcedValue"
        },
        "bytes": {
          "$ref": "#/$defs/SourcedValue"
        },
        "bytes_per_cycle_per_bank": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "bytes",
        "banks",
        "bytes_per_cycle_per_bank"
      ],
      "title": "Sram",
      "type": "object"
    },
    "Sync": {
      "additionalProperties": false,
      "properties": {
        "barrier_latency_cycles": {
          "$ref": "#/$defs/SourcedValue"
        },
        "mechanism": {
          "enum": [
            "noc_semaphore",
            "hardware_barrier"
          ],
          "title": "Mechanism",
          "type": "string"
        }
      },
      "required": [
        "mechanism",
        "barrier_latency_cycles"
      ],
      "title": "Sync",
      "type": "object"
    },
    "TimingPreset": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha"
      ],
      "title": "TimingPreset",
      "type": "object"
    },
    "VectorEngine": {
      "additionalProperties": false,
      "properties": {
        "ops_per_cycle": {
          "$ref": "#/$defs/SourcedValue"
        }
      },
      "required": [
        "ops_per_cycle"
      ],
      "title": "VectorEngine",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hardware inputs. Unit/path consistency is semantic validation; x-hardware-unit-rules lists exact allowed labels, without conversion. Coordinates are count indices; formats.*.bytes is an implicit byte width; energy.voltage_ratio keys are dimensionless frequency ratios. byte and B are equivalent labels preserved verbatim.",
  "properties": {
    "clock_domains": {
      "$ref": "#/$defs/ClockDomains"
    },
    "cores": {
      "$ref": "#/$defs/Cores"
    },
    "design_status": {
      "enum": [
        "proposed",
        "reference"
      ],
      "title": "Design Status",
      "type": "string"
    },
    "energy": {
      "$ref": "#/$defs/Energy"
    },
    "formats": {
      "additionalProperties": {
        "$ref": "#/$defs/NumericFormat"
      },
      "propertyNames": {
        "$ref": "#/$defs/PrecisionFormat"
      },
      "title": "Formats",
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "memory": {
      "$ref": "#/$defs/Memory"
    },
    "nocs": {
      "items": {
        "$ref": "#/$defs/Noc"
      },
      "minItems": 1,
      "title": "Nocs",
      "type": "array"
    },
    "shared_sram": {
      "anyOf": [
        {
          "$ref": "#/$defs/SharedSram"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "static_power_w": {
      "$ref": "#/$defs/SourcedValue"
    },
    "sync": {
      "$ref": "#/$defs/Sync"
    },
    "tdp_w": {
      "$ref": "#/$defs/SourcedValue"
    }
  },
  "required": [
    "id",
    "design_status",
    "clock_domains",
    "cores",
    "sync",
    "nocs",
    "memory",
    "formats",
    "energy",
    "static_power_w",
    "tdp_w"
  ],
  "title": "HardwareSpec",
  "type": "object",
