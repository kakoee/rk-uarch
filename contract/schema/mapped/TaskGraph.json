          {
            "$ref": "#/$defs/Dma"
          },
          {
            "$ref": "#/$defs/NocTransfer"
          },
          {
            "$ref": "#/$defs/Barrier"
          },
          {
            "$ref": "#/$defs/FixedDelay"
          }
