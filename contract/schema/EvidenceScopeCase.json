      "title": "Hardware Spec Hash"
    },
    "initial_state": {
      "enum": [
        "steady",
        "cold"
      ],
      "title": "Initial State",
      "type": "string"
    },
    "intensity_regime": {
      "anyOf": [
        {
          "enum": [
            "low",
            "middle",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Intensity Regime"
