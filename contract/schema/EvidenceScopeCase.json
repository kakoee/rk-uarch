    "kv_block_size_tokens": {
      "minimum": 1,
      "title": "Kv Block Size Tokens",
      "type": "integer"
    },
    "mapping_correspondence_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mapping Correspondence Hash"
    },
    "mapping_match": {
      "anyOf": [
        {
          "enum": [
            "matched",
            "compiler-chosen"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mapping Match"
    },
    "model_identity_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Identity Hash",
      "type": "string"
