{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "matrix_ops": {
      "minimum": 0,
      "title": "Matrix Ops",
      "type": "number"
    },
    "memory_read_bytes": {
      "minimum": 0,
      "title": "Memory Read Bytes",
      "type": "number"
    },
    "memory_write_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Memory Write Bytes"
    },
    "vector_ops": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Vector Ops"
    }
  },
  "required": [
    "matrix_ops",
    "vector_ops",
    "memory_read_bytes",
    "memory_write_bytes"
  ],
  "title": "Counts",
  "type": "object"
}
