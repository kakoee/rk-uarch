    "FlopParity": {
      "additionalProperties": false,
      "description": "Explicit classification; self-tests never establish actual workload parity.\n\nAll fields are required, including nullable identities. Manifest digests use B's\nraw 64-hex spelling, unlike hardware_spec_hash's sha256: prefix. External oracle,\nfixture completeness, projection eligibility and callable identity need B/U-P3 checks.",
      "properties": {
        "candidate_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Identity"
        },
        "comparisons": {
          "items": {
            "$ref": "#/$defs/ParityChannelComparison"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "fixture_set_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fixture Set Id"
        },
        "kind": {
          "enum": [
            "not_run",
            "harness_self_test",
            "workload_parity"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_rel": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Rel"
        },
        "n_fixtures": {
          "minimum": 0,
          "title": "N Fixtures",
          "type": "integer"
        },
        "oracle_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Oracle Manifest Sha256"
        },
        "reference_basis": {
          "const": "rk_sim_aggregate_divided_by_tp",
          "title": "Reference Basis",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference_basis",
        "fixture_set_id",
        "oracle_manifest_sha256",
        "candidate_identity",
        "n_fixtures",
        "max_rel",
        "comparisons"
      ],
      "title": "FlopParity",
      "type": "object"
    },
