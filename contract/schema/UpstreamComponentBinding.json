{
  "$defs": {
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Binding Hash",
      "type": "string"
    },
    "component_bytes_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Component Bytes Sha256",
      "type": "string"
    },
    "component_file": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Component File",
      "type": "string"
    },
    "component_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Component Id",
      "type": "string"
    },
    "execution_model_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Model Hash",
      "type": "string"
    },
    "format": {
      "const": "uarch-upstream-component/1",
      "title": "Format",
      "type": "string"
    },
    "kind": {
      "const": "upstream_only",
      "title": "Kind",
      "type": "string"
    },
    "oracle_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Oracle Manifest Sha256",
      "type": "string"
    },
    "supported_kv_storage": {
      "items": {
        "$ref": "#/$defs/PrecisionFormat"
      },
      "minItems": 1,
      "title": "Supported Kv Storage",
      "type": "array",
      "uniqueItems": true
    },
    "upstream_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Upstream Sha",
      "type": "string"
    }
  },
  "required": [
    "binding_hash",
    "component_bytes_sha256",
    "component_file",
    "component_id",
    "execution_model_hash",
    "format",
    "kind",
    "oracle_manifest_sha256",
    "supported_kv_storage",
    "upstream_sha"
  ],
  "title": "UpstreamComponentBinding",
  "type": "object"
}
