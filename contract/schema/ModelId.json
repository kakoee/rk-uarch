{
  "$defs": {
    "FidelityDetail": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Compute",
          "type": "integer"
        },
        "dram": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Dram"
        },
        "layer_reuse": {
          "title": "Layer Reuse",
          "type": "boolean"
        },
        "noc": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Noc"
        },
        "shared_sram": {
          "description": "Omit only when hardware has no shared SRAM; null is invalid.",
          "enum": [
            0,
            1,
            "1+ts",
            "unrepresented"
          ],
          "title": "Shared Sram"
        },
        "sync": {
          "pattern": "^(exact|approx\\(Q=[1-9][0-9]*\\))$",
          "title": "Sync",
          "type": "string"
        }
      },
      "required": [
        "compute",
        "noc",
        "dram",
        "sync",
        "layer_reuse"
      ],
      "title": "FidelityDetail",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Engine",
      "type": "string"
    },
    "engine_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Engine Version",
      "type": "string"
    },
    "fidelity_detail": {
      "$ref": "#/$defs/FidelityDetail"
    },
    "mapping_policy": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Mapping Policy",
      "type": "string"
    }
  },
  "required": [
    "engine",
    "engine_version",
    "fidelity_detail",
    "mapping_policy"
  ],
  "title": "ModelId",
  "type": "object"
}
