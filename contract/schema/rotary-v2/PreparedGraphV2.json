{
  "$defs": {
    "KvAccess": {
      "additionalProperties": false,
      "properties": {
        "block_size_tokens": {
          "minimum": 1,
          "title": "Block Size Tokens",
          "type": "integer"
        },
        "context_tokens": {
          "minimum": 1,
          "title": "Context Tokens",
          "type": "integer"
        },
        "last_page_valid_tokens": {
          "minimum": 1,
          "title": "Last Page Valid Tokens",
          "type": "integer"
        },
        "pages_per_sequence": {
          "minimum": 1,
          "title": "Pages Per Sequence",
          "type": "integer"
        },
        "read_policy": {
          "const": "valid_tokens",
          "title": "Read Policy",
          "type": "string"
        },
        "write_policy": {
          "const": "append_valid_tokens",
          "title": "Write Policy",
          "type": "string"
        }
      },
      "required": [
        "block_size_tokens",
        "context_tokens",
        "last_page_valid_tokens",
        "pages_per_sequence",
        "read_policy",
        "write_policy"
      ],
      "title": "KvAccess",
      "type": "object"
    },
    "OpGroupV2": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "head",
            "decoder",
            "tail"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/PreparedOpV2"
          },
          "minItems": 1,
          "title": "Ops",
          "type": "array"
        },
        "repeat": {
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        }
      },
      "required": [
        "depends_on",
        "id",
        "kind",
        "ops",
        "repeat"
      ],
      "title": "OpGroupV2",
      "type": "object"
    },
    "OpSpec": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "patternProperties": {
            "\\S": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Dimensions",
          "type": "object"
        },
        "operands": {
          "patternProperties": {
            "\\S": {
              "$ref": "#/$defs/Operand"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Operands",
          "type": "object"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "reduction_axes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Reduction Axes",
          "type": "array"
        }
      },
      "required": [
        "operator",
        "dimensions",
        "operands",
        "reduction_axes"
      ],
      "title": "OpSpec",
      "type": "object"
    },
    "Operand": {
      "additionalProperties": false,
      "properties": {
        "block_size_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Size Tokens"
        },
        "dimensions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "dtype": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "layout": {
          "enum": [
            "contiguous",
            "paged"
          ],
          "title": "Layout",
          "type": "string"
        }
      },
      "required": [
        "dtype",
        "dimensions",
        "layout"
      ],
      "title": "Operand",
      "type": "object"
    },
    "Operator": {
      "enum": [
        "q_projection",
        "k_projection",
        "v_projection",
        "qk_score",
        "softmax",
        "av_application",
        "output_projection",
        "normalization",
        "residual_addition",
        "ffn_up",
        "ffn_gate",
        "ffn_down",
        "activation",
        "kv_write",
        "embedding",
        "lm_head",
        "attention_fused"
      ],
      "title": "Operator",
      "type": "string"
    },
    "Padding": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "logical": {
          "minimum": 1,
          "title": "Logical",
          "type": "integer"
        },
        "physical": {
          "minimum": 1,
          "title": "Physical",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "logical",
        "physical"
      ],
      "title": "Padding",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "PreparedOpV2": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Depends On",
          "type": "array"
        },
        "embedding_local_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Embedding Local Tokens"
        },
        "fusion": {
          "enum": [
            "none",
            "qk_softmax_av"
          ],
          "title": "Fusion",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kv_access": {
          "anyOf": [
            {
              "$ref": "#/$defs/KvAccess"
            },
            {
              "type": "null"
            }
          ]
        },
        "operand_access": {
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "read_write"
            ],
            "type": "string"
          },
          "title": "Operand Access",
          "type": "object"
        },
        "padding": {
          "items": {
            "$ref": "#/$defs/Padding"
          },
          "minItems": 0,
          "title": "Padding",
          "type": "array"
        },
        "replication": {
          "items": {
            "$ref": "#/$defs/Replication"
          },
          "minItems": 0,
          "title": "Replication",
          "type": "array"
        },
        "rotary": {
          "anyOf": [
            {
              "$ref": "#/$defs/RotaryBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "$ref": "#/$defs/RotaryOpSpec"
            }
          ],
          "title": "Spec"
        },
        "weight_copies": {
          "minimum": 1,
          "title": "Weight Copies",
          "type": "integer"
        },
        "work_repeat": {
          "minimum": 1,
          "title": "Work Repeat",
          "type": "integer"
        }
      },
      "required": [
        "depends_on",
        "embedding_local_tokens",
        "fusion",
        "id",
        "kv_access",
        "operand_access",
        "padding",
        "replication",
        "spec",
        "weight_copies",
        "work_repeat",
        "rotary"
      ],
      "title": "PreparedOpV2",
      "type": "object"
    },
    "Replication": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "global_extent": {
          "minimum": 1,
          "title": "Global Extent",
          "type": "integer"
        },
        "rank_extent": {
          "minimum": 1,
          "title": "Rank Extent",
          "type": "integer"
        },
        "replicas": {
          "minimum": 1,
          "title": "Replicas",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "global_extent",
        "rank_extent",
        "replicas"
      ],
      "title": "Replication",
      "type": "object"
    },
    "RotaryBinding": {
      "additionalProperties": false,
      "properties": {
        "coefficients_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Coefficients Hash",
          "type": "string"
        },
        "input_op_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Input Op Id",
          "type": "string"
        },
        "numeric_policy": {
          "const": "fp32-separate-round-rne/1",
          "title": "Numeric Policy",
          "type": "string"
        },
        "pairing": {
          "enum": [
            "adjacent",
            "split_halves"
          ],
          "title": "Pairing",
          "type": "string"
        },
        "position_ids": {
          "items": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Position Ids",
          "type": "array"
        },
        "target": {
          "enum": [
            "q",
            "k"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "coefficients_hash",
        "pairing",
        "numeric_policy",
        "position_ids",
        "input_op_id"
      ],
      "title": "RotaryBinding",
      "type": "object"
    },
    "RotaryEncoding": {
      "additionalProperties": false,
      "properties": {
        "cache_key_state": {
          "const": "rotated-before-store",
          "title": "Cache Key State",
          "type": "string"
        },
        "coefficients_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Coefficients Hash",
          "type": "string"
        },
        "kind": {
          "const": "rope-precomputed/1",
          "title": "Kind",
          "type": "string"
        },
        "numeric_policy": {
          "const": "fp32-separate-round-rne/1",
          "title": "Numeric Policy",
          "type": "string"
        },
        "pairing": {
          "enum": [
            "adjacent",
            "split_halves"
          ],
          "title": "Pairing",
          "type": "string"
        },
        "position_policy": {
          "const": "zero-origin-contiguous/1",
          "title": "Position Policy",
          "type": "string"
        },
        "rotary_dim": {
          "minimum": 1,
          "title": "Rotary Dim",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "rotary_dim",
        "pairing",
        "coefficients_hash",
        "position_policy",
        "cache_key_state",
        "numeric_policy"
      ],
      "title": "RotaryEncoding",
      "type": "object"
    },
    "RotaryOpSpec": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "patternProperties": {
            "\\S": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Dimensions",
          "type": "object"
        },
        "operands": {
          "patternProperties": {
            "\\S": {
              "$ref": "#/$defs/Operand"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Operands",
          "type": "object"
        },
        "operator": {
          "const": "rotary_embedding",
          "title": "Operator",
          "type": "string"
        },
        "reduction_axes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Reduction Axes",
          "type": "array"
        }
      },
      "required": [
        "operator",
        "dimensions",
        "operands",
        "reduction_axes"
      ],
      "title": "RotaryOpSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attention_mask": {
      "enum": [
        "full_square",
        "causal"
      ],
      "title": "Attention Mask",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/OpGroupV2"
      },
      "minItems": 1,
      "title": "Groups",
      "type": "array"
    },
    "kv_key_encoding": {
      "$ref": "#/$defs/RotaryEncoding"
    },
    "lm_head_tokens": {
      "minimum": 1,
      "title": "Lm Head Tokens",
      "type": "integer"
    },
    "omissions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 4,
      "title": "Omissions",
      "type": "array"
    }
  },
  "required": [
    "attention_mask",
    "groups",
    "lm_head_tokens",
    "omissions",
    "kv_key_encoding"
  ],
  "title": "PreparedGraphV2",
  "type": "object"
}
