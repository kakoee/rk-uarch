{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coefficients_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Coefficients Hash",
      "type": "string"
    },
    "input_op_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Input Op Id",
      "type": "string"
    },
    "numeric_policy": {
      "const": "fp32-separate-round-rne/1",
      "title": "Numeric Policy",
      "type": "string"
    },
    "pairing": {
      "enum": [
        "adjacent",
        "split_halves"
      ],
      "title": "Pairing",
      "type": "string"
    },
    "position_ids": {
      "items": {
        "items": {
          "minimum": 0,
          "type": "integer"
        },
        "minItems": 1,
        "type": "array"
      },
      "minItems": 1,
      "title": "Position Ids",
      "type": "array"
    },
    "target": {
      "enum": [
        "q",
        "k"
      ],
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "target",
    "coefficients_hash",
    "pairing",
    "numeric_policy",
    "position_ids",
    "input_op_id"
  ],
  "title": "RotaryBinding",
  "type": "object"
}
