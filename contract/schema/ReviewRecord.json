{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "pending"
      ],
      "title": "Decision",
      "type": "string"
    },
    "format": {
      "const": "uarch-evidence-review/1",
      "title": "Format",
      "type": "string"
    },
    "independent": {
      "title": "Independent",
      "type": "boolean"
    },
    "rationale": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Rationale",
      "type": "string"
    },
    "review_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Review Hash",
      "type": "string"
    },
    "reviewed_subject_hashes": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reviewed Subject Hashes",
      "type": "array"
    },
    "reviewer": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reviewer",
      "type": "string"
    }
  },
  "required": [
    "decision",
    "format",
    "independent",
    "rationale",
    "review_hash",
    "reviewed_subject_hashes",
    "reviewer"
  ],
  "title": "ReviewRecord",
  "type": "object"
}
