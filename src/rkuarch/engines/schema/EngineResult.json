{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "matrix_ops": {
          "minimum": 0,
          "title": "Matrix Ops",
          "type": "number"
        },
        "memory_read_bytes": {
          "minimum": 0,
          "title": "Memory Read Bytes",
          "type": "number"
        },
        "memory_write_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Write Bytes"
        },
        "vector_ops": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vector Ops"
        }
      },
      "required": [
        "matrix_ops",
        "vector_ops",
        "memory_read_bytes",
        "memory_write_bytes"
      ],
      "title": "Counts",
      "type": "object"
    },
    "Diagnostics": {
      "additionalProperties": false,
      "properties": {
        "dma_compute_overlap_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dma Compute Overlap Ratio"
        },
        "dram_bw_util_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dram Bw Util Ratio"
        },
        "dram_row_hit_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dram Row Hit Ratio"
        },
        "matrix_util_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matrix Util Ratio"
        },
        "noc_latency_p50_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Noc Latency P50 S"
        },
        "noc_latency_p99_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Noc Latency P99 S"
        },
        "noc_max_link_util_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Noc Max Link Util Ratio"
        },
        "sram_bank_conflict_stall_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sram Bank Conflict Stall Ratio"
        },
        "vector_util_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Util Ratio"
        }
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "EngineIdentity": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "name": {
          "const": "analytic",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "model",
        "name",
        "version"
      ],
      "title": "EngineIdentity",
      "type": "object"
    },
    "EngineResultAttributionPs": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "ge": 0,
          "title": "Compute",
          "type": "number"
        },
        "memory": {
          "ge": 0,
          "title": "Memory",
          "type": "number"
        },
        "noc": {
          "ge": 0,
          "title": "Noc",
          "type": "number"
        },
        "overhead": {
          "ge": 0,
          "title": "Overhead",
          "type": "number"
        },
        "sync": {
          "ge": 0,
          "title": "Sync",
          "type": "number"
        }
      },
      "required": [
        "compute",
        "memory",
        "noc",
        "overhead",
        "sync"
      ],
      "title": "EngineResultAttributionPs",
      "type": "object"
    },
    "EngineResultBusyTimePs": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "anyOf": [
            {
              "ge": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compute"
        },
        "memory": {
          "anyOf": [
            {
              "ge": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory"
        },
        "noc": {
          "anyOf": [
            {
              "ge": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Noc"
        }
      },
      "required": [
        "compute",
        "memory",
        "noc"
      ],
      "title": "EngineResultBusyTimePs",
      "type": "object"
    },
    "FidelityDetail": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Compute",
          "type": "integer"
        },
        "dram": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Dram"
        },
        "layer_reuse": {
          "title": "Layer Reuse",
          "type": "boolean"
        },
        "noc": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Noc"
        },
        "shared_sram": {
          "description": "Omit only when hardware has no shared SRAM; null is invalid.",
          "enum": [
            0,
            1,
            "1+ts",
            "unrepresented"
          ],
          "title": "Shared Sram"
        },
        "sync": {
          "pattern": "^(exact|approx\\(Q=[1-9][0-9]*\\))$",
          "title": "Sync",
          "type": "string"
        }
      },
      "required": [
        "compute",
        "noc",
        "dram",
        "sync",
        "layer_reuse"
      ],
      "title": "FidelityDetail",
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "name": {
          "enum": [
            "physical-resolved",
            "nominal-rk-compatibility"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "name",
        "version"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "OpResult": {
      "additionalProperties": false,
      "properties": {
        "achieved_ops_per_s": {
          "anyOf": [
            {
              "ge": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Achieved Ops Per S"
        },
        "bound": {
          "enum": [
            "compute",
            "memory"
          ],
          "title": "Bound",
          "type": "string"
        },
        "compute_time_ps": {
          "ge": 0,
          "title": "Compute Time Ps",
          "type": "number"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "dram_bw_bytes_per_s": {
          "gt": 0,
          "title": "Dram Bw Bytes Per S",
          "type": "number"
        },
        "duration_ps": {
          "ge": 0,
          "title": "Duration Ps",
          "type": "number"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "instances": {
          "minimum": 1,
          "title": "Instances",
          "type": "integer"
        },
        "matrix_peak_ops_per_s": {
          "gt": 0,
          "title": "Matrix Peak Ops Per S",
          "type": "number"
        },
        "memory_time_ps": {
          "ge": 0,
          "title": "Memory Time Ps",
          "type": "number"
        },
        "operational_intensity_ops_per_byte": {
          "anyOf": [
            {
              "ge": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operational Intensity Ops Per Byte"
        },
        "ridge_ops_per_byte": {
          "gt": 0,
          "title": "Ridge Ops Per Byte",
          "type": "number"
        },
        "scope": {
          "$ref": "#/$defs/ReportScope"
        },
        "vector_peak_ops_per_s": {
          "gt": 0,
          "title": "Vector Peak Ops Per S",
          "type": "number"
        }
      },
      "required": [
        "achieved_ops_per_s",
        "bound",
        "compute_time_ps",
        "counts",
        "dram_bw_bytes_per_s",
        "duration_ps",
        "group_id",
        "id",
        "instances",
        "matrix_peak_ops_per_s",
        "memory_time_ps",
        "operational_intensity_ops_per_byte",
        "ridge_ops_per_byte",
        "scope",
        "vector_peak_ops_per_s"
      ],
      "title": "OpResult",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "ReportScope": {
      "additionalProperties": false,
      "properties": {
        "array_fill": {
          "anyOf": [
            {
              "enum": [
                "underfilled",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Array Fill"
        },
        "dram_load_regime": {
          "anyOf": [
            {
              "enum": [
                "low",
                "middle",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dram Load Regime"
        },
        "intensity_regime": {
          "anyOf": [
            {
              "enum": [
                "low",
                "middle",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Intensity Regime"
        },
        "mapping_match": {
          "anyOf": [
            {
              "enum": [
                "matched",
                "compiler-chosen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mapping Match"
        },
        "noc_load_regime": {
          "anyOf": [
            {
              "enum": [
                "low",
                "middle",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Noc Load Regime"
        },
        "op_class": {
          "minLength": 1,
          "title": "Op Class",
          "type": "string"
        },
        "precision_roles": {
          "$ref": "#/$defs/ReportScopePrecisionRoles"
        }
      },
      "required": [
        "array_fill",
        "dram_load_regime",
        "intensity_regime",
        "mapping_match",
        "noc_load_regime",
        "op_class",
        "precision_roles"
      ],
      "title": "ReportScope",
      "type": "object"
    },
    "ReportScopePrecisionRoles": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "kv_cache": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "operands": {
          "additionalProperties": {
            "$ref": "#/$defs/PrecisionFormat"
          },
          "title": "Operands",
          "type": "object"
        }
      },
      "required": [
        "compute",
        "kv_cache",
        "operands"
      ],
      "title": "ReportScopePrecisionRoles",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribution_ps": {
      "$ref": "#/$defs/EngineResultAttributionPs"
    },
    "busy_time_ps": {
      "$ref": "#/$defs/EngineResultBusyTimePs"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "diagnostics": {
      "$ref": "#/$defs/Diagnostics"
    },
    "duration_ps": {
      "ge": 0,
      "title": "Duration Ps",
      "type": "number"
    },
    "engine": {
      "$ref": "#/$defs/EngineIdentity"
    },
    "fidelity_detail": {
      "$ref": "#/$defs/FidelityDetail"
    },
    "job_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Job Hash",
      "type": "string"
    },
    "per_op": {
      "items": {
        "$ref": "#/$defs/OpResult"
      },
      "minItems": 1,
      "title": "Per Op",
      "type": "array"
    },
    "protocol": {
      "const": "uarch-engine/1",
      "title": "Protocol",
      "type": "string"
    },
    "result_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Hash",
      "type": "string"
    },
    "simulator_metrics": {
      "title": "Simulator Metrics",
      "type": "null"
    },
    "trace": {
      "title": "Trace",
      "type": "null"
    },
    "u_c0_duration_ps": {
      "ge": 0,
      "title": "U C0 Duration Ps",
      "type": "number"
    },
    "unrepresented": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "title": "Unrepresented",
      "type": "array"
    }
  },
  "required": [
    "attribution_ps",
    "busy_time_ps",
    "counts",
    "diagnostics",
    "duration_ps",
    "engine",
    "fidelity_detail",
    "job_hash",
    "per_op",
    "protocol",
    "result_hash",
    "simulator_metrics",
    "trace",
    "u_c0_duration_ps",
    "unrepresented"
  ],
  "title": "EngineResult",
  "type": "object"
}
