{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "implementation_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "name": {
      "const": "physical-resolved",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "const": "2",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "implementation_hash",
    "name",
    "version"
  ],
  "title": "ModelIdentityV2",
  "type": "object"
}
