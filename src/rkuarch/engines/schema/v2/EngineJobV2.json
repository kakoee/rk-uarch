{
  "$defs": {
    "DecodeQuery": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "minimum": 1,
          "title": "Batch",
          "type": "integer"
        },
        "phase": {
          "const": "decode",
          "title": "Phase",
          "type": "string"
        },
        "total_context_tokens": {
          "minimum": 1,
          "title": "Total Context Tokens",
          "type": "integer"
        }
      },
      "required": [
        "batch",
        "phase",
        "total_context_tokens"
      ],
      "title": "DecodeQuery",
      "type": "object"
    },
    "EngineIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentityV2"
        },
        "name": {
          "const": "analytic",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": "resolved-ops/2",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "model",
        "name",
        "version"
      ],
      "title": "EngineIdentityV2",
      "type": "object"
    },
    "FidelityDetail": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Compute",
          "type": "integer"
        },
        "dram": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Dram"
        },
        "layer_reuse": {
          "title": "Layer Reuse",
          "type": "boolean"
        },
        "noc": {
          "enum": [
            0,
            1,
            "1+ts",
            2
          ],
          "title": "Noc"
        },
        "shared_sram": {
          "description": "Omit only when hardware has no shared SRAM; null is invalid.",
          "enum": [
            0,
            1,
            "1+ts",
            "unrepresented"
          ],
          "title": "Shared Sram"
        },
        "sync": {
          "pattern": "^(exact|approx\\(Q=[1-9][0-9]*\\))$",
          "title": "Sync",
          "type": "string"
        }
      },
      "required": [
        "compute",
        "noc",
        "dram",
        "sync",
        "layer_reuse"
      ],
      "title": "FidelityDetail",
      "type": "object"
    },
    "KvAccess": {
      "additionalProperties": false,
      "properties": {
        "block_size_tokens": {
          "minimum": 1,
          "title": "Block Size Tokens",
          "type": "integer"
        },
        "context_tokens": {
          "minimum": 1,
          "title": "Context Tokens",
          "type": "integer"
        },
        "last_page_valid_tokens": {
          "minimum": 1,
          "title": "Last Page Valid Tokens",
          "type": "integer"
        },
        "pages_per_sequence": {
          "minimum": 1,
          "title": "Pages Per Sequence",
          "type": "integer"
        },
        "read_policy": {
          "const": "valid_tokens",
          "title": "Read Policy",
          "type": "string"
        },
        "write_policy": {
          "const": "append_valid_tokens",
          "title": "Write Policy",
          "type": "string"
        }
      },
      "required": [
        "block_size_tokens",
        "context_tokens",
        "last_page_valid_tokens",
        "pages_per_sequence",
        "read_policy",
        "write_policy"
      ],
      "title": "KvAccess",
      "type": "object"
    },
    "ModelIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "name": {
          "const": "physical-resolved",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": "2",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "name",
        "version"
      ],
      "title": "ModelIdentityV2",
      "type": "object"
    },
    "OpGroupV2": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "head",
            "decoder",
            "tail"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/PreparedOpV2"
          },
          "minItems": 1,
          "title": "Ops",
          "type": "array"
        },
        "repeat": {
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        }
      },
      "required": [
        "depends_on",
        "id",
        "kind",
        "ops",
        "repeat"
      ],
      "title": "OpGroupV2",
      "type": "object"
    },
    "OpSpec": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "patternProperties": {
            "\\S": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Dimensions",
          "type": "object"
        },
        "operands": {
          "patternProperties": {
            "\\S": {
              "$ref": "#/$defs/Operand"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Operands",
          "type": "object"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "reduction_axes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Reduction Axes",
          "type": "array"
        }
      },
      "required": [
        "operator",
        "dimensions",
        "operands",
        "reduction_axes"
      ],
      "title": "OpSpec",
      "type": "object"
    },
    "Operand": {
      "additionalProperties": false,
      "properties": {
        "block_size_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Size Tokens"
        },
        "dimensions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "dtype": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "layout": {
          "enum": [
            "contiguous",
            "paged"
          ],
          "title": "Layout",
          "type": "string"
        }
      },
      "required": [
        "dtype",
        "dimensions",
        "layout"
      ],
      "title": "Operand",
      "type": "object"
    },
    "Operator": {
      "enum": [
        "q_projection",
        "k_projection",
        "v_projection",
        "qk_score",
        "softmax",
        "av_application",
        "output_projection",
        "normalization",
        "residual_addition",
        "ffn_up",
        "ffn_gate",
        "ffn_down",
        "activation",
        "kv_write",
        "embedding",
        "lm_head",
        "attention_fused"
      ],
      "title": "Operator",
      "type": "string"
    },
    "Padding": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "logical": {
          "minimum": 1,
          "title": "Logical",
          "type": "integer"
        },
        "physical": {
          "minimum": 1,
          "title": "Physical",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "logical",
        "physical"
      ],
      "title": "Padding",
      "type": "object"
    },
    "Precision": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "$ref": "#/$defs/PrecisionFormat",
          "default": "fp16"
        },
        "kv_cache": {
          "$ref": "#/$defs/PrecisionFormat",
          "default": "fp16"
        }
      },
      "title": "Precision",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "fp32",
        "tf32",
        "bf16",
        "fp16",
        "fp8",
        "int8",
        "fp4",
        "int4"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "PrefillQuery": {
      "additionalProperties": false,
      "properties": {
        "n_prompts": {
          "minimum": 1,
          "title": "N Prompts",
          "type": "integer"
        },
        "phase": {
          "const": "prefill",
          "title": "Phase",
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 1,
          "title": "Prompt Tokens",
          "type": "integer"
        }
      },
      "required": [
        "n_prompts",
        "phase",
        "prompt_tokens"
      ],
      "title": "PrefillQuery",
      "type": "object"
    },
    "PreparedGraphV2": {
      "additionalProperties": false,
      "properties": {
        "attention_mask": {
          "enum": [
            "full_square",
            "causal"
          ],
          "title": "Attention Mask",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/OpGroupV2"
          },
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "kv_key_encoding": {
          "$ref": "#/$defs/RotaryEncoding"
        },
        "lm_head_tokens": {
          "minimum": 1,
          "title": "Lm Head Tokens",
          "type": "integer"
        },
        "omissions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 4,
          "title": "Omissions",
          "type": "array"
        }
      },
      "required": [
        "attention_mask",
        "groups",
        "lm_head_tokens",
        "omissions",
        "kv_key_encoding"
      ],
      "title": "PreparedGraphV2",
      "type": "object"
    },
    "PreparedOpV2": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Depends On",
          "type": "array"
        },
        "embedding_local_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Embedding Local Tokens"
        },
        "fusion": {
          "enum": [
            "none",
            "qk_softmax_av"
          ],
          "title": "Fusion",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kv_access": {
          "anyOf": [
            {
              "$ref": "#/$defs/KvAccess"
            },
            {
              "type": "null"
            }
          ]
        },
        "operand_access": {
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "read_write"
            ],
            "type": "string"
          },
          "title": "Operand Access",
          "type": "object"
        },
        "padding": {
          "items": {
            "$ref": "#/$defs/Padding"
          },
          "minItems": 0,
          "title": "Padding",
          "type": "array"
        },
        "replication": {
          "items": {
            "$ref": "#/$defs/Replication"
          },
          "minItems": 0,
          "title": "Replication",
          "type": "array"
        },
        "rotary": {
          "anyOf": [
            {
              "$ref": "#/$defs/RotaryBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "$ref": "#/$defs/RotaryOpSpec"
            }
          ],
          "title": "Spec"
        },
        "weight_copies": {
          "minimum": 1,
          "title": "Weight Copies",
          "type": "integer"
        },
        "work_repeat": {
          "minimum": 1,
          "title": "Work Repeat",
          "type": "integer"
        }
      },
      "required": [
        "depends_on",
        "embedding_local_tokens",
        "fusion",
        "id",
        "kv_access",
        "operand_access",
        "padding",
        "replication",
        "spec",
        "weight_copies",
        "work_repeat",
        "rotary"
      ],
      "title": "PreparedOpV2",
      "type": "object"
    },
    "PreparedPointV2": {
      "additionalProperties": false,
      "properties": {
        "embedding_hits": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Embedding Hits",
          "type": "array"
        },
        "frequency_ratio": {
          "gt": 0,
          "title": "Frequency Ratio",
          "type": "number"
        },
        "graph": {
          "$ref": "#/$defs/PreparedGraphV2"
        },
        "hit_source": {
          "enum": [
            "provided_counts",
            "synthetic_balanced_assignment",
            "tp1_trivial"
          ],
          "title": "Hit Source",
          "type": "string"
        },
        "initial_state": {
          "enum": [
            "steady",
            "cold"
          ],
          "title": "Initial State",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "query": {
          "discriminator": {
            "mapping": {
              "decode": "#/$defs/DecodeQuery",
              "prefill": "#/$defs/PrefillQuery"
            },
            "propertyName": "phase"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DecodeQuery"
            },
            {
              "$ref": "#/$defs/PrefillQuery"
            }
          ],
          "title": "Query"
        }
      },
      "required": [
        "embedding_hits",
        "frequency_ratio",
        "graph",
        "hit_source",
        "initial_state",
        "payload_hash",
        "query"
      ],
      "title": "PreparedPointV2",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "RankScope": {
      "additionalProperties": false,
      "properties": {
        "collectives": {
          "const": "excluded",
          "title": "Collectives",
          "type": "string"
        },
        "equivalent_ranks": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Equivalent Ranks",
          "type": "array"
        },
        "kind": {
          "enum": [
            "balanced_tp_representative",
            "balanced_tp_selected_rank"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rank_index": {
          "minimum": 0,
          "title": "Rank Index",
          "type": "integer"
        },
        "tp": {
          "minimum": 1,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "collectives",
        "equivalent_ranks",
        "kind",
        "rank_index",
        "tp"
      ],
      "title": "RankScope",
      "type": "object"
    },
    "Replication": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "global_extent": {
          "minimum": 1,
          "title": "Global Extent",
          "type": "integer"
        },
        "rank_extent": {
          "minimum": 1,
          "title": "Rank Extent",
          "type": "integer"
        },
        "replicas": {
          "minimum": 1,
          "title": "Replicas",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "global_extent",
        "rank_extent",
        "replicas"
      ],
      "title": "Replication",
      "type": "object"
    },
    "ResolvedHardware": {
      "additionalProperties": false,
      "properties": {
        "array_cols": {
          "minimum": 1,
          "title": "Array Cols",
          "type": "integer"
        },
        "array_rows": {
          "minimum": 1,
          "title": "Array Rows",
          "type": "integer"
        },
        "core_freq_hz": {
          "minimum": 1,
          "title": "Core Freq Hz",
          "type": "integer"
        },
        "dram_bw_bytes_per_s": {
          "gt": 0,
          "title": "Dram Bw Bytes Per S",
          "type": "number"
        },
        "dram_capacity_bytes": {
          "minimum": 1,
          "title": "Dram Capacity Bytes",
          "type": "integer"
        },
        "dram_freq_hz": {
          "minimum": 1,
          "title": "Dram Freq Hz",
          "type": "integer"
        },
        "hardware_spec_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hardware Spec Hash",
          "type": "string"
        },
        "matrix_peak_ops_per_s": {
          "gt": 0,
          "title": "Matrix Peak Ops Per S",
          "type": "number"
        },
        "noc_freq_hz": {
          "minimum": 1,
          "title": "Noc Freq Hz",
          "type": "integer"
        },
        "vector_peak_ops_per_s": {
          "gt": 0,
          "title": "Vector Peak Ops Per S",
          "type": "number"
        }
      },
      "required": [
        "array_cols",
        "array_rows",
        "core_freq_hz",
        "dram_bw_bytes_per_s",
        "dram_capacity_bytes",
        "dram_freq_hz",
        "hardware_spec_hash",
        "matrix_peak_ops_per_s",
        "noc_freq_hz",
        "vector_peak_ops_per_s"
      ],
      "title": "ResolvedHardware",
      "type": "object"
    },
    "RotaryBinding": {
      "additionalProperties": false,
      "properties": {
        "coefficients_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Coefficients Hash",
          "type": "string"
        },
        "input_op_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Input Op Id",
          "type": "string"
        },
        "numeric_policy": {
          "const": "fp32-separate-round-rne/1",
          "title": "Numeric Policy",
          "type": "string"
        },
        "pairing": {
          "enum": [
            "adjacent",
            "split_halves"
          ],
          "title": "Pairing",
          "type": "string"
        },
        "position_ids": {
          "items": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Position Ids",
          "type": "array"
        },
        "target": {
          "enum": [
            "q",
            "k"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "coefficients_hash",
        "pairing",
        "numeric_policy",
        "position_ids",
        "input_op_id"
      ],
      "title": "RotaryBinding",
      "type": "object"
    },
    "RotaryCoefficients": {
      "additionalProperties": false,
      "properties": {
        "coefficients_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Coefficients Hash",
          "type": "string"
        },
        "cos_bits": {
          "items": {
            "items": {
              "pattern": "^[0-9a-f]{8}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Cos Bits",
          "type": "array"
        },
        "dtype": {
          "const": "fp32",
          "title": "Dtype",
          "type": "string"
        },
        "format": {
          "const": "uarch-rotary-coefficients/1",
          "title": "Format",
          "type": "string"
        },
        "position_count": {
          "minimum": 1,
          "title": "Position Count",
          "type": "integer"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "rotary_dim": {
          "minimum": 1,
          "title": "Rotary Dim",
          "type": "integer"
        },
        "sin_bits": {
          "items": {
            "items": {
              "pattern": "^[0-9a-f]{8}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Sin Bits",
          "type": "array"
        }
      },
      "required": [
        "format",
        "coefficients_hash",
        "position_count",
        "rotary_dim",
        "dtype",
        "cos_bits",
        "sin_bits",
        "producer"
      ],
      "title": "RotaryCoefficients",
      "type": "object"
    },
    "RotaryEncoding": {
      "additionalProperties": false,
      "properties": {
        "cache_key_state": {
          "const": "rotated-before-store",
          "title": "Cache Key State",
          "type": "string"
        },
        "coefficients_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Coefficients Hash",
          "type": "string"
        },
        "kind": {
          "const": "rope-precomputed/1",
          "title": "Kind",
          "type": "string"
        },
        "numeric_policy": {
          "const": "fp32-separate-round-rne/1",
          "title": "Numeric Policy",
          "type": "string"
        },
        "pairing": {
          "enum": [
            "adjacent",
            "split_halves"
          ],
          "title": "Pairing",
          "type": "string"
        },
        "position_policy": {
          "const": "zero-origin-contiguous/1",
          "title": "Position Policy",
          "type": "string"
        },
