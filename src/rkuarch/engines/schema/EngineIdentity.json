{
  "$defs": {
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "implementation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Hash",
          "type": "string"
        },
        "name": {
          "enum": [
            "physical-resolved",
            "nominal-rk-compatibility"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_hash",
        "name",
        "version"
      ],
      "title": "ModelIdentity",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "implementation_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "name": {
      "const": "analytic",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "implementation_hash",
    "model",
    "name",
    "version"
  ],
  "title": "EngineIdentity",
  "type": "object"
}
