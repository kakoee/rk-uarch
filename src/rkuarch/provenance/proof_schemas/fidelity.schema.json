{
  "$id": "urn:u2-proof-proposal:fidelity:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "minLength": 1,
      "type": "string"
    },
    "compiler_source_identity": {
      "minLength": 1,
      "type": "string"
    },
    "compiler_source_version": {
      "minLength": 1,
      "type": "string"
    },
    "counters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "enum": [
              "count",
              "byte"
            ]
          },
          "value": {
            "anyOf": [
              {
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "unit",
          "value",
          "availability",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "format": {
      "const": "u2-proof-fidelity/2"
    },
    "prepared_bundle_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "counts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "enum": [
              "matrix_ops",
              "vector_ops",
              "memory_read_bytes",
              "memory_write_bytes"
            ]
          },
          "value": {
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
            "type": "string"
          },
          "unit": {
            "enum": [
              "count",
              "byte"
            ]
          }
        },
        "required": [
          "case_id",
          "quantity",
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "benchmark_id",
    "scope_sha256",
    "prepared_bundle_hash",
    "compiler_source_identity",
    "compiler_source_version",
    "counters",
    "counts"
  ],
  "type": "object"
}
