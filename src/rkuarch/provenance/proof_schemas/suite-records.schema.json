{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "u2-proof-suite-plan/2"
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "benchmark_id": {
                "type": "string",
                "minLength": 1
              },
              "model_identity_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "input_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "kind": {
                "enum": [
                  "engine_result",
                  "nominal_output"
                ]
              },
              "metric_pointer": {
                "type": "string",
                "pattern": "^/.*$"
              },
              "group_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "operator_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "enum": [
                  "duration",
                  "matrix_ops",
                  "vector_ops",
                  "memory_read_bytes",
                  "memory_write_bytes"
                ]
              },
              "source_unit": {
                "enum": [
                  "ps",
                  "s",
                  "count",
                  "byte"
                ]
              },
              "purpose": {
                "enum": [
                  "duration",
                  "counts",
                  "diagnostics",
                  "energy"
                ]
              },
              "granularity": {
                "enum": [
                  "operator",
                  "whole_iteration"
                ]
              },
              "required_roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "prediction",
                    "verification_observed",
                    "fidelity_count"
                  ]
                }
              },
              "independent_expected": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source_record_hash": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "member_name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*\\.(json|csv|txt)$"
                      },
                      "member_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "source_record_hash",
                      "member_name",
                      "member_sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "case_id",
              "benchmark_id",
              "model_identity_hash",
              "input_hash",
              "kind",
              "metric_pointer",
              "group_id",
              "operator_id",
              "quantity",
              "source_unit",
              "purpose",
              "granularity",
              "required_roles",
              "independent_expected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "suite_id",
        "suite_version",
        "cases"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "u2-proof-capture-inventory/2"
        },
        "suite_plan": {
          "type": "object",
          "properties": {
            "source_record_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "member_name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.(json|csv|txt)$"
            },
            "member_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "source_record_hash",
            "member_name",
            "member_sha256"
          ],
          "additionalProperties": false
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "benchmark_id": {
                "type": "string",
                "minLength": 1
              },
              "capture": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "engine_result",
                      "nominal_output"
                    ]
                  },
                  "value": {
                    "type": "object",
                    "properties": {
                      "artifact_hash": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "json_pointer": {
                        "type": "string",
                        "pattern": "^(/.*)?$"
                      }
                    },
                    "required": [
                      "artifact_hash",
                      "json_pointer"
                    ],
                    "additionalProperties": false
                  },
                  "model_identity_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "input_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "bundle_hash": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "point_hash": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "group_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "operator_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity": {
                    "enum": [
                      "duration",
                      "matrix_ops",
                      "vector_ops",
                      "memory_read_bytes",
                      "memory_write_bytes"
                    ]
                  },
                  "source_unit": {
                    "enum": [
                      "ps",
                      "s",
                      "count",
                      "byte"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "value",
                  "model_identity_hash",
                  "input_hash",
                  "bundle_hash",
                  "point_hash",
                  "group_id",
                  "operator_id",
                  "quantity",
                  "source_unit"
                ],
                "additionalProperties": false
              },
              "outcome": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run"
                ]
              }
            },
            "required": [
              "case_id",
              "benchmark_id",
              "capture",
              "outcome"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "suite_plan",
        "cases"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "u2-proof-independent-expected/2"
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "model_input_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "quantity": {
                "enum": [
                  "duration",
                  "matrix_ops",
                  "vector_ops",
                  "memory_read_bytes",
                  "memory_write_bytes"
                ]
              },
              "source_unit": {
                "enum": [
                  "ps",
                  "s",
                  "count",
                  "byte"
                ]
              },
              "value_decimal": {
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                "type": "string"
              },
              "absolute_tolerance_decimal": {
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                "type": "string"
              },
              "rule": {
                "const": "absolute-difference-le-tolerance"
              },
              "original_reference": {
                "type": "object",
                "properties": {
                  "source_record_hash": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "member_name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*\\.(json|csv|txt)$"
                  },
                  "member_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "source_record_hash",
                  "member_name",
                  "member_sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "case_id",
              "model_input_hash",
              "quantity",
              "source_unit",
              "value_decimal",
              "absolute_tolerance_decimal",
              "rule",
              "original_reference"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "suite_id",
        "suite_version",
        "cases"
      ],
      "additionalProperties": false
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:u2-proof-proposal:revision2:suite-records.schema.json"
}
