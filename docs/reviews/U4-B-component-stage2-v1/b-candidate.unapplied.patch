+        ("out", "request_noc", "service", 0, 4000, router, "noc", "noc", True, 4),
+        ("lat-a", "dram_latency", "alignment", 4000, 4000, channel, "memory", "dram", False, 0),
+        ("lat", "dram_latency", "service", 4000, 52000, channel, "memory", "dram", False, 48),
