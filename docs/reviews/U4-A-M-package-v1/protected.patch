+    model: NativeModelIdentity
+    compiler_lock_hash: Hash
+
+
+class NativeFidelity(FrozenModel):
+    compute: Literal[1]
+    noc: Literal[0]
+    dram: Literal[0]
+    sync: Literal["exact"]
+    layer_reuse: Literal[False]
+
+
+class ClockSetup(FrozenModel):
+    job_id: NonEmpty
+    domain: Literal["core", "noc", "dram"]
+    start_ps: U64
+    n_cycles: U64
