+            end = max((jobs[x].end_ps for x in buffer.final_consumer_ids), default=None)
+            require(
+                (row.allocate_ps, row.free_ps) == (jobs[buffer.producer_id].start_ps, end),
+                "IncompleteObservations",
+                "producer allocation endpoints",
+            )
