    },
    "repository": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Repository",
      "type": "string"
    }
  },
  "required": [
    "format",
    "repository",
    "acceptance_commit",
    "record_path",
    "record_byte_hash"
  ],
  "title": "ComponentHostSelector",
  "type": "object"
