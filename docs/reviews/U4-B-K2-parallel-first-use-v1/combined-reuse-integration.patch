+def resolve_campaign_hosts(base, plan, host):
+    # A's public session produces genuine bindings. The facade only routes the
+    # original release/subject checks through its mode selector; it creates no token.
+    global STATE
+    with host.resolution_session() as select:
+        try:
+            yield base.authority(plan, SimpleNamespace(resolve_host=select))
+        finally:
+            STATE = None
 
 
