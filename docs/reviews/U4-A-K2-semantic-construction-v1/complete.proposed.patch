+"""Synthetic subrecord/schema controls only; no completed native result fixture."""
+
+from typing import Literal, cast
+
+import pytest
+from uarch_contract.mapped import (
+    ClockObservation,
+    CriticalInterval,
+    EventObservation,
+    QueueObservation,
+)
+
+
+def test_public_raw_edge_and_owned_zero_are_distinct_fields() -> None:
+    value = dict(
+        job_id="z",
+        domain="core",
+        grant_ps=835,
+        n_cycles=0,
+        raw_edge_outcome="success",
+        aligned_start_ps=1667,
+        completion_ps=835,
+    )
+    assert ClockObservation.model_validate(value).completion_ps == 835
+    with pytest.raises(ValueError):
+        ClockObservation.model_validate(dict(value, n_cycles=True))
+    with pytest.raises(ValueError):
+        ClockObservation.model_validate(dict(value, raw_edge_outcome="TimeOverflow"))
+
+
+def test_diagnostic_overflow_is_explicit_not_zero_job_failure() -> None:
+    maximum = 2**64 - 1
+    value = ClockObservation(
+        job_id="z",
+        domain="core",
+        grant_ps=maximum,
+        n_cycles=0,
+        raw_edge_outcome="TimeOverflow",
+        aligned_start_ps=None,
+        completion_ps=maximum,
+    )
+    assert value.aligned_start_ps is None
+
+
+@pytest.mark.parametrize("kind", ["TASK_RELEASE", "DEPENDENCY_READY", "OWNER_GRANT"])
+def test_complete_public_event_vocabulary(
+    kind: Literal["TASK_RELEASE", "DEPENDENCY_READY", "OWNER_GRANT"],
+) -> None:
+    value = EventObservation(
+        event_seq=0,
+        observation_ordinal=0,
+        t_ps=835,
+        phase=2 if kind == "OWNER_GRANT" else 1,
+        target_id=0,
+        kind=kind,
+        job_id="z",
+    )
+    assert value.kind == kind
+
+
+def test_idle_is_distinct_from_resource_service() -> None:
+    idle = dict(
+        kind="release_idle",
+        start_ps=0,
+        end_ps=835,
+        cause_job_id="z",
+        predecessor_id=None,
+        limiting_resource_id=None,
+        category="overhead",
+    )
+    assert CriticalInterval.model_validate(idle).limiting_resource_id is None
+    for update in (
+        {"limiting_resource_id": 0},
+        {"predecessor_id": "p"},
+        {"category": "compute"},
+        {"start_ps": 1},
+        {"end_ps": 0},
+    ):
+        with pytest.raises(ValueError):
+            CriticalInterval.model_validate(dict(idle, **update))
+    with pytest.raises(ValueError):
+        CriticalInterval.model_validate(dict(idle, kind="service"))
+    assert CriticalInterval.model_validate(dict(idle, kind="service", limiting_resource_id=0))
+
+
+def test_non_clocked_fifo_does_not_invent_domain() -> None:
+    value = QueueObservation(
+        queue_id="owner:0:waiting",
+        item_id="z",
+        population="waiting",
+        enter_ps=835,
+        leave_ps=2000,
+        owner_id=0,
+        clock_domain=None,
+    )
+    assert value.clock_domain is None
+
+
+def test_generated_mirrors_fresh() -> None:
+    from uarch_contract.generate_mapped import generate
+
+    assert generate(check=True) == []
+
+
+@pytest.mark.parametrize("release,aligned", [(0, 0), (835, 1667)])
+def test_synthetic_accounting_subrecords_and_faults(release: int, aligned: int) -> None:
+    # Deliberately partial namespaces: cannot serialize as MappedEngineResult/native evidence.
+    import copy
+    from types import SimpleNamespace as NS
+    from typing import Any
+
+    from uarch_contract.mapped import (
+        ClockSetup,
+        FixedDelay,
+        JobObservation,
+        Observed,
+        validate_fixed_delay_observations,
+    )
+
+    setup = ClockSetup(job_id="z", domain="core", start_ps=release, n_cycles=0)
+    declared = FixedDelay(id="z", duration_ps=0, owner_id=0, kind="fixed_delay")
+    job: Any = NS(
+        clock_setup=(setup,),
+        freq_hz=NS(core=1200000000),
+        mapped_point=NS(task_graph=NS(jobs=(declared,), dependencies=())),
+    )
+    record = JobObservation(
+        job_id="z",
+        op_id=None,
+        group_id=None,
+        repeat_index=None,
+        tile_origin=None,
+        tile_extents=None,
+        release_ps=release,
+        ready_ps=release,
+        start_ps=release,
+        end_ps=release,
+        owner_id=0,
+        blocking_predecessor_ids=(),
+        useful_matrix_ops=0,
+        issued_matrix_ops=0,
+        vector_arithmetic_ops=0,
+        cast_ops=0,
+    )
+    kinds: tuple[Literal["TASK_RELEASE", "TASK_READY", "OWNER_GRANT", "COMPUTE_DONE"], ...] = (
+        "TASK_RELEASE" if release else "TASK_READY",
+        "OWNER_GRANT",
+        "COMPUTE_DONE",
+    )
+    events = tuple(
+        EventObservation(
+            event_seq=i,
+            observation_ordinal=i,
+            t_ps=release,
+            phase=1 if i == 0 else 2,
+            target_id=0,
+            kind=kind,
+            job_id="z",
+        )
+        for i, kind in enumerate(kinds)
+    )
+    clock = ClockObservation(
+        job_id="z",
+        domain="core",
+        grant_ps=release,
+        n_cycles=0,
+        raw_edge_outcome="success",
+        aligned_start_ps=aligned,
+        completion_ps=release,
+    )
+    queues = tuple(
+        QueueObservation(
+            queue_id="owner:0:" + p,
+            item_id="z",
+            population=p,
+            enter_ps=release,
+            leave_ps=release,
+            owner_id=0,
+            clock_domain=None,
+        )
+        for p in ("service", "waiting")
+    )
+    critical = (
+        (
+            CriticalInterval(
+                kind="release_idle",
+                start_ps=0,
+                end_ps=release,
+                cause_job_id="z",
+                predecessor_id=None,
+                limiting_resource_id=None,
+                category="overhead",
+            ),
+        )
+        if release
+        else ()
+    )
+    r: Any = NS(
+        duration_ps=release,
+        simulator_metrics=NS(event_count=3, max_live_events=1),
+        observations=NS(
+            dma=NS(status="unrepresented"),
+            transfers=NS(status="unrepresented"),
+            allocations=NS(status="unrepresented"),
+            jobs=NS(records=(record,)),
+            events=NS(records=events),
+            clocks=Observed[ClockObservation](status="observed", records=(clock,)),
+            queue_membership=Observed[QueueObservation](status="observed", records=queues),
+            resource_intervals=NS(records=()),
+            critical_path=NS(records=critical),
+        ),
+    )
+    validate_fixed_delay_observations(r, job)
+    for fault in ("alignment", "domain", "blocker", "critical", "dispatch", "metrics"):
+        bad = copy.deepcopy(r)
+        if fault == "alignment":
+            bad.observations.clocks = Observed[ClockObservation](
+                status="observed",
+                records=(clock.model_copy(update={"aligned_start_ps": aligned + 1}),),
+            )
+        elif fault == "domain":
+            bad.observations.queue_membership = Observed[QueueObservation](
+                status="observed",
+                records=(queues[0].model_copy(update={"clock_domain": "core"}), queues[1]),
+            )
+        elif fault == "blocker":
+            bad.observations.jobs.records = (
+                record.model_copy(update={"blocking_predecessor_ids": ("z",)}),
+            )
+        elif fault == "critical":
+            bad.observations.critical_path.records = (
+                ()
+                if release
+                else (
+                    NS(
+                        kind="service",
+                        start_ps=0,
+                        end_ps=0,
+                        cause_job_id="z",
+                        predecessor_id=None,
+                        limiting_resource_id=0,
+                        category="overhead",
+                    ),
+                )
+            )
+        elif fault == "dispatch":
+            bad.observations.events.records = events[:-1]
+        else:
+            bad.simulator_metrics.event_count = 4
+        with pytest.raises(ValueError):
+            validate_fixed_delay_observations(bad, job)
+        validate_fixed_delay_observations(r, job)  # restored structural positive, not native
+
