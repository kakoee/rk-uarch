{
  "$defs": {
    "FileBinding": {
      "additionalProperties": false,
      "properties": {
        "byte_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Byte Hash",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "byte_hash"
      ],
      "title": "FileBinding",
      "type": "object"
    },
    "ModeConfig": {
      "additionalProperties": false,
      "properties": {
        "cargo_args": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Cargo Args",
          "type": "array"
        },
        "mode": {
          "enum": [
            "debug",
            "release"
          ],
          "title": "Mode",
          "type": "string"
        },
        "rustflags": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Rustflags",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "cargo_args",
        "rustflags"
      ],
      "title": "ModeConfig",
      "type": "object"
    },
    "SourceInput": {
      "additionalProperties": false,
      "properties": {
        "byte_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Byte Hash",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "rust",
            "canonicalization",
            "schema",
            "build-script",
            "generator",
            "python-build-helper",
            "config",
            "trust",
            "tool-input"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "byte_hash",
        "role"
      ],
      "title": "SourceInput",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "uarch-k2-build-inputs/1",
      "title": "Format",
      "type": "string"
    },
    "generated_identity_output_paths": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Generated Identity Output Paths",
      "type": "array"
    },
    "mode_configs": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/ModeConfig"
        },
        {
          "$ref": "#/$defs/ModeConfig"
        }
      ],
      "title": "Mode Configs",
      "type": "array"
    },
    "model_inputs_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Inputs Hash",
      "type": "string"
    },
    "model_source_paths": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Model Source Paths",
      "type": "array"
    },
    "permitted_environment": {
      "patternProperties": {
        "\\S": {
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Permitted Environment",
      "type": "object"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_files": {
      "items": {
        "$ref": "#/$defs/SourceInput"
      },
      "minItems": 1,
      "title": "Source Files",
      "type": "array"
    },
    "tool_inputs_file": {
      "$ref": "#/$defs/FileBinding"
    },
    "tool_inputs_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Tool Inputs Hash",
      "type": "string"
    },
    "trust_file": {
      "$ref": "#/$defs/FileBinding"
    },
    "trust_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Trust Hash",
      "type": "string"
    }
  },
  "required": [
    "format",
    "source_commit",
    "source_files",
    "trust_hash",
    "trust_file",
    "tool_inputs_hash",
    "tool_inputs_file",
    "model_source_paths",
    "model_inputs_hash",
    "mode_configs",
    "generated_identity_output_paths",
    "permitted_environment"
  ],
  "title": "BuildInputs",
  "type": "object"
}
