diff --git a/validation/component/runtime_resources.py b/validation/component/runtime_resources.py
new file mode 100644
index 0000000..076e6dc
--- /dev/null
+++ b/validation/component/runtime_resources.py
@@ -0,0 +1,141 @@
+"""Read visible unified-cgroup limits without assuming root has non-root controls.
+
+Component-private orchestration only. The historical K2 helper stays byte-exact.
+Its budget arithmetic is supplied by the caller after checking its frozen hash.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+
+def require(ok: bool, reason: str) -> None:
+    if not ok:
+        raise ValueError(reason)
+
+
+def _path(raw: str) -> Path:
+    decoded = re.sub(r"\\(040|011|012|134)", lambda m: chr(int(m[1], 8)), raw)
+    value = Path(decoded)
+    require(
+        value.is_absolute() and ".." not in value.parts, "absolute unescaped cgroup path required"
+    )
+    return value
+
+
+def inspect_cgroups(membership: str, mountinfo: str) -> dict[str, Any]:
+    entries = [line[3:] for line in membership.splitlines() if line.startswith("0::")]
+    require(len(entries) == 1, "one unified cgroup-v2 membership required")
+    name = Path(entries[0])
+    require(name.is_absolute() and ".." not in name.parts, "absolute cgroup membership required")
+    mounts = []
+    for line in mountinfo.splitlines():
+        before, separator, after = line.partition(" - ")
+        if separator and after.split()[0] == "cgroup2":
+            fields = before.split()
+            require(len(fields) >= 6, "complete cgroup mountinfo required")
+            mounts.append((_path(fields[3]), _path(fields[4])))
+    require(len(mounts) == 1, "one unambiguous cgroup-v2 mount required")
+    mounted_root, mount = mounts[0]
+    require(mounted_root == Path("/"), "hidden mount ancestors require a reviewed environment")
+    require(
+        {"cpu", "memory"} <= set((mount / "cgroup.controllers").read_text().split()),
+        "CPU and memory controllers must be exposed",
+    )
+    current = mount / name.relative_to("/")
+    require(current.resolve().is_relative_to(mount.resolve()), "cgroup path must stay inside mount")
+    quotas: list[tuple[int, int]] = []
+    memory: list[tuple[int, int]] = []
+    observed: list[dict[str, Any]] = []
+    while True:
+        values: dict[str, str | None] = {}
+        for field in ("cpu.max", "memory.max", "memory.current"):
+            try:
+                values[field] = (current / field).read_text().strip()
+            except FileNotFoundError:
+                values[field] = None
+        # Linux's actual hierarchy root has no non-root interface, including cgroup.type.
+        # A namespace/mount root WITH controls must still contribute all its limits.
+        if all(v is None for v in values.values()) and current == mount:
+            try:
+                (current / "cgroup.type").read_text()
+            except FileNotFoundError:
+                observed.append(
+                    {
+                        "path": str(current),
+                        "interface": "hierarchy-root-no-bandwidth-or-memory-interface",
+                    }
+                )
+                break
+            raise ValueError("missing controls at namespace root")
+        require(
+            all(v is not None for v in values.values()),
+            "incomplete non-root or partial-root limits",
+        )
+        raw_cpu, raw_mem, raw_used = (
+            values["cpu.max"],
+            values["memory.max"],
+            values["memory.current"],
+        )
+        assert raw_cpu is not None and raw_mem is not None and raw_used is not None
+        q, p = raw_cpu.split()
+        require(int(p) > 0 and (q == "max" or int(q) > 0), "invalid CPU quota")
+        used = int(raw_used)
+        require(
+            used >= 0 and (raw_mem == "max" or int(raw_mem) >= 0), "invalid memory limit/current"
+        )
+        if q != "max":
+            quotas.append((int(q), int(p)))
+        if raw_mem != "max":
+            memory.append((int(raw_mem), used))
+        observed.append({"path": str(current), **values, "memory.current": used})
+        if current == mount:
+            break
+        current = current.parent
+    return dict(
+        membership=str(name),
+        mount=str(mount),
+        mounted_root=str(mounted_root),
+        quotas=quotas,
+        memory=memory,
+        observed_cgroups=observed,
+    )
+
+
+def discover(
+    policy: dict[str, Any], tasks: int, *, select_resources: Callable[..., dict[str, Any]]
+) -> dict[str, Any]:
+    membership = Path("/proc/self/cgroup").read_text()
+    mountinfo = Path("/proc/self/mountinfo").read_text()
+    limits = inspect_cgroups(membership, mountinfo)
+    info = dict(line.split(":", 1) for line in Path("/proc/meminfo").read_text().splitlines())
+    amount, unit = info["MemAvailable"].split()
+    require(unit == "kB" and int(amount) >= 0, "measured MemAvailable in kB required")
+    affinity = os.sched_getaffinity(0)
+    result = select_resources(
+        affinity,
+        limits["quotas"],
+        int(amount) * 1024,
+        limits["memory"],
+        reserve=policy["memory_reserve_bytes"],
+        per_worker=policy["per_worker_memory_bytes"],
+        tasks=tasks,
+    )
+    require(
+        Path("/proc/self/cgroup").read_text() == membership
+        and Path("/proc/self/mountinfo").read_text() == mountinfo
+        and os.sched_getaffinity(0) == affinity,
+        "resource membership changed during discovery",
+    )
+    result.update({k: v for k, v in limits.items() if k not in ("quotas", "memory")})
+    result["limitations"] = (
+        "Visible cgroup limits, affinity and current MemAvailable only; "
+        "namespace-hidden ancestors and competing future allocations are not inferred. "
+        "No resource setting changed. Worker/container loss still stops the run. "
+        "Docker per-call limits remain separately enforced; this is no host reservation."
+    )
+    return result
diff --git a/validation/component/test_runtime_resources.py b/validation/component/test_runtime_resources.py
new file mode 100644
index 0000000..ef1ff22
--- /dev/null
+++ b/validation/component/test_runtime_resources.py
@@ -0,0 +1,124 @@
+"""Synthetic Linux interface controls; no native results or authority."""
+
+import runpy
+from pathlib import Path
+
+import pytest
+
+from validation.component.runtime_resources import inspect_cgroups
+
+ROOT = Path(__file__).resolve().parents[2]
+SELECT = runpy.run_path(
+    str(ROOT / "docs/reviews/U4-B-K2-parallel-first-use-v1/resource_limits.py")
+)["select_resources"]
+
+
+def fixture(tmp_path, name="/parent/worker"):
+    mount = tmp_path / "cgroup"
+    group = mount / name.lstrip("/")
+    group.mkdir(parents=True)
+    (mount / "cgroup.controllers").write_text("cpu memory pids cpuset\n")
+    for p in (mount / "parent", group):
+        if p == mount:
+            continue
+        p.mkdir(exist_ok=True)
+        (p / "cgroup.type").write_text("domain\n")
+        (p / "cpu.max").write_text("max 100000\n")
+        (p / "memory.max").write_text("max\n")
+        (p / "memory.current").write_text("100\n")
+    info = f"120 111 0:23 / {mount} rw - cgroup2 cgroup2 rw\n"
+    return mount, group, f"0::{name}\n", info
+
+
+def budget(value):
+    return SELECT(
+        set(range(8)),
+        value["quotas"],
+        10_000,
+        value["memory"],
+        reserve=500,
+        per_worker=1000,
+        tasks=8,
+    )
+
+
+def test_real_root_absence_does_not_mean_missing_child_limits(tmp_path):
+    mount, group, membership, info = fixture(tmp_path)
+    value = inspect_cgroups(membership, info)
+    assert budget(value)["workers"] == 8
+    assert (
+        value["observed_cgroups"][-1]["interface"]
+        == "hierarchy-root-no-bandwidth-or-memory-interface"
+    )
+    (group / "cpu.max").unlink()
+    with pytest.raises(ValueError, match="incomplete non-root"):
+        inspect_cgroups(membership, info)
+
+
+def test_every_ancestor_cpu_and_memory_limit_is_applied(tmp_path):
+    mount, group, membership, info = fixture(tmp_path)
+    (mount / "parent/cpu.max").write_text("250000 100000\n")
+    (group / "memory.max").write_text("7000\n")
+    value = inspect_cgroups(membership, info)
+    assert budget(value)["workers"] == 2
+    assert budget(value)["effective_cpu_capacity"] == "5/2"
+    (mount / "parent/memory.max").write_text("2500\n")
+    assert budget(inspect_cgroups(membership, info))["workers"] == 1
+    (mount / "parent/cpu.max").write_text("50000 100000\n")
+    with pytest.raises(ValueError, match="less than one"):
+        budget(inspect_cgroups(membership, info))
+
+
+def test_mount_root_with_limits_is_never_skipped(tmp_path):
+    mount, _, membership, info = fixture(tmp_path)
+    (mount / "cgroup.type").write_text("domain\n")
+    (mount / "cpu.max").write_text("100000 100000\n")
+    (mount / "memory.max").write_text("2000\n")
+    (mount / "memory.current").write_text("100\n")
+    assert budget(inspect_cgroups(membership, info))["workers"] == 1
+    (mount / "memory.max").write_text("1200\n")
+    with pytest.raises(ValueError, match="insufficient measured memory"):
+        budget(inspect_cgroups(membership, info))
+
+
+@pytest.mark.parametrize(
+    "attack",
+    [
+        "partial-root",
+        "namespace-missing-controls",
+        "missing-ancestor",
+        "hidden-mount",
+        "parent-escape",
+        "ambiguous-mount",
+        "no-memory-controller",
+        "malformed-cpu",
+        "negative-memory",
+    ],
+)
+def test_unknown_or_invalid_limits_refuse(tmp_path, attack):
+    mount, group, membership, info = fixture(tmp_path)
+    if attack == "partial-root":
+        (mount / "cpu.max").write_text("max 100000\n")
+    elif attack == "namespace-missing-controls":
+        (mount / "cgroup.type").write_text("domain\n")
+    elif attack == "missing-ancestor":
+        (mount / "parent/memory.max").unlink()
+    elif attack == "hidden-mount":
+        info = info.replace("0:23 / ", "0:23 /hidden ")
+    elif attack == "parent-escape":
+        membership = "0::/../worker\n"
+    elif attack == "ambiguous-mount":
+        info += info
+    elif attack == "no-memory-controller":
+        (mount / "cgroup.controllers").write_text("cpu\n")
+    elif attack == "malformed-cpu":
+        (group / "cpu.max").write_text("max 0\n")
+    elif attack == "negative-memory":
+        (group / "memory.current").write_text("-1\n")
+    with pytest.raises(ValueError):
+        inspect_cgroups(membership, info)
+
+
+def test_membership_is_literal_but_mountinfo_escapes_are_decoded(tmp_path):
+    mount, group, membership, info = fixture(tmp_path, name=r"/parent/worker\040name")
+    assert inspect_cgroups(membership, info)["observed_cgroups"][0]["path"] == str(group)
