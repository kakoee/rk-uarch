+        job_id="c",
+        request_id=None,
+        subphase="compute_overhead",
+        kind="service",
+        ready_ps=0,
+        start_ps=0,
+        end_ps=32000,
+        owner_id=0,
+        category="overhead",
+        receiving_domain="core",
