+            r["observations"]["queue_membership"]["records"].append(q)
+    else:
+        raise ValueError(name)
+    for a in r["observations"]["activities"]["records"]:
+        a["predecessors"].sort(key=lambda p: (p["activity_id"], p["relation"]))
+    return j, synchronize(r)
