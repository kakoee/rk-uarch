+
+@pytest.mark.parametrize(
+    "field,detail",
+    [
+        ("owner", "job owner"),
+        ("release", "component release"),
+        ("blocking", "unrepresented job predecessors"),
+        ("critical", "unrepresented critical predecessor"),
+        ("event", "activity event kind"),
+    ],
