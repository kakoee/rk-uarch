+"""Consistently resealed synthetic carriers; never component outputs/native evidence.
+Inputs independently hand constructed by B; attacks reproduce reviewer M1/M2/M3/M4/V1.
+"""
+from copy import deepcopy
+import pytest
+from uarch_contract.hashing import content_hash
+from uarch_contract.mapped import validate_result
+from validation.component.synthetic_carrier import synthetic_job, synthetic_result, synthetic_port_pair
+
+
+def records(r, section):
+    return r['observations'][section]['records']
+
+
+def act(r, name):
+    return next(a for a in records(r, 'activities') if a['activity_id'] == name)
+
+
+def seal(r):
+    r['result_hash'] = content_hash(r, exclude=('result_hash',))
+    return r
+
+
+def sample(case='D01'):
+    j = synthetic_job(case)
+    r = synthetic_port_pair(j) if case == 'D08' else synthetic_result(j)
+    # Explicit proposed endpoint encoding, independent of production implementation.
+    kinds = {
+        'read_port': ('OWNER_GRANT', 'DMA_DONE'), 'write_port': ('OWNER_GRANT', 'MEM_RESP'),
+        'channel_service': ('MEM_REQ', 'MEM_RESP'), 'dram_latency': ('MEM_REQ', 'MEM_RESP'),
+        'ack': ('TASK_READY', 'DMA_DONE'), 'barrier': ('SYNC_ARRIVE', 'BARRIER_RELEASE'),
+    }
+    ev = {e['observation_ordinal']: e for e in records(r, 'events')}
+    for a in records(r, 'activities'):
+        pair = ('TASK_READY', 'DEPENDENCY_READY') if a['kind'] == 'alignment' else (
+            ('NOC_HEAD', 'NOC_TAIL') if a['subphase'].endswith('_noc') else
+            ('OWNER_GRANT', 'COMPUTE_DONE') if a['subphase'].startswith('compute_') else kinds[a['subphase']])
+        ev[a['dispatch_ordinal']]['kind'], ev[a['completion_ordinal']]['kind'] = pair
+    for c in records(r, 'critical_path'):
+        c['predecessor_id'] = None
+    return j, seal(r)
+
+
+def rebusy(r):
+    for b in r['busy_time_ps']:
+        end = total = 0
+        for lo, hi in sorted((x['start_ps'], x['end_ps']) for x in records(r,'resource_intervals') if x['owner_id']==b['owner_id']):
+            total += max(0, hi-max(lo,end)); end=max(end,hi)
+        b['busy_time_ps']=total
+
+
+@pytest.mark.parametrize('case', ['D01','D08','D10-read'])
+def test_structural_positive(case):
+    j,r=sample(case)
+    validate_result(r,j)
+
+
+@pytest.mark.parametrize('part', ['category', 'domain'])
+def test_M1_relabel(part):
+    j,r=sample('D10-read')
+    a=act(r,'back-a')
+    if part == 'category':
+        a['category']='memory'
+        for c in records(r,'critical_path'):
+            if c['activity_id']=='back-a':
+                c['category']='memory'
+                delta=c['end_ps']-c['start_ps']
+                r['attribution_ps']['noc']-=delta; r['attribution_ps']['memory']+=delta
+    else:
+        a['receiving_domain']='dram'
+        for c in records(r,'clocks'):
+            if c['activity_id']=='back-a': c['domain']='dram'
+        for q in records(r,'queue_membership'):
+            if q['activity_id']=='back-a': q['clock_domain']='dram'
+    with pytest.raises(ValueError,match='^IncompleteObservations: activity category/domain$'):
+        validate_result(seal(r),j)
+
+
+def test_M2_owner_forgery():
+    j,r=sample()
+    port=next(o.owner_id for o in j.owners if o.resource=='dma_port:0')
+    a=act(r,'out'); a['owner_id']=port
+    for e in records(r,'events'):
+        if e['observation_ordinal'] in (a['dispatch_ordinal'],a['completion_ordinal']): e['target_id']=port
+    for x in records(r,'resource_intervals'):
+        if x['activity_id']=='out': x['owner_id']=x['limiting_resource_id']=port
+    for q in records(r,'queue_membership'):
+        if q['activity_id']=='out': q.update(owner_id=port,queue_id=f'activity:request_noc:{port}')
+    for c in records(r,'critical_path'):
+        if c['activity_id']=='out': c['limiting_resource_id']=port
+    rebusy(r)
+    with pytest.raises(ValueError,match='^InvalidResource: activity owner$'):
+        validate_result(seal(r),j)
+
+
+def test_M3_missing_off_chain_cause():
+    j,r=sample('D08')
+    act(r,'r1:back-a')['predecessors']=[]
+    with pytest.raises(ValueError,match='^AttributionMismatch: missing tight cause$'):
+        validate_result(seal(r),j)
+
+
+def test_M4_nonoccupying_channel():
+    j,r=sample()
+    ch,ba=act(r,'channel'),act(r,'back-a')
+    ch.update(occupies_resource=False,end_ps=54500)
+    ba.update(ready_ps=54500,start_ps=54500)
+    r['observations']['resource_intervals']['records']=[x for x in records(r,'resource_intervals') if x['activity_id']!='channel']
+    for e in records(r,'events'):
+        if e['observation_ordinal'] in (ch['completion_ordinal'],ba['dispatch_ordinal']): e['t_ps']=54500
+    for q in records(r,'queue_membership'):
+        if q['queue_id'].startswith('channel_service:') and q['population']=='service': q['leave_ps']=54500
+        if q['activity_id']=='back-a':
+            q['enter_ps']=54500
+            if q['population']=='waiting': q['leave_ps']=54500
+    for t in records(r,'transfers'):
+        if t['boundary_id']=='dram': t['leave_ps']=54500
+        if t['boundary_id']=='response_noc': t['enter_ps']=54500
+    for c in records(r,'clocks'):
+        if c['activity_id']=='back-a': c['grant_ps']=54500
+    for c in records(r,'critical_path'):
+        if c['activity_id']=='channel': c['end_ps']=54500
+        if c['activity_id']=='back-a': c['start_ps']=54500
+    r['attribution_ps']['memory']+=250; r['attribution_ps']['noc']-=250
+    rebusy(r)
+    with pytest.raises(ValueError,match='^IncompleteObservations: phase occupancy$'):
+        validate_result(seal(r),j)
+
+
+def test_V1_credit_only_first_from_last():
+    j,r=sample('D08')
+    a=act(r,'r1:port')
+    a['predecessors'].append(dict(activity_id='r0:port',relation='credit'))
+    a['predecessors'].sort(key=lambda p:(p['activity_id'],p['relation']))
+    with pytest.raises(ValueError,match='^AttributionMismatch: credit endpoints$'):
+        validate_result(seal(r),j)
+
+
+@pytest.mark.parametrize('field,detail', [
+    ('owner','job owner'), ('release','component release'), ('blocking','unrepresented job predecessors'),
+    ('critical','unrepresented critical predecessor'), ('event','activity event kind'),
+])
+def test_F8_resealed_fields(field,detail):
+    j,r=sample('D08')
+    row=records(r,'jobs')[0]
+    if field=='owner': row['owner_id']=next(o.owner_id for o in j.owners if o.resource=='channel:6')
+    if field=='release': row['release_ps']=50000
+    if field=='blocking': row['blocking_predecessor_ids']=['r01']
+    if field=='critical': records(r,'critical_path')[-1]['predecessor_id']='FORGED'
+    if field=='event':
+        next(e for e in records(r,'events') if e['kind']=='DMA_DONE')['kind']='STAT_SAMPLE'
+    with pytest.raises(ValueError,match='^(IncompleteObservations|AttributionMismatch|InvalidResource): '+detail+'$'):
+        validate_result(seal(r),j)
+    validate_result(sample('D08')[1],j)
+
+
+def synthetic():
+    j, r = sample()
+    rows = records(r, 'queue_membership')
+    rows.sort(key=lambda q: not q['queue_id'].startswith('channel_service:'))
+    return j, r
+
+
+def check(job, raw):
+    raw = deepcopy(raw)
+    raw["result_hash"] = content_hash(raw, exclude=("result_hash",))
+    return validate_result(raw, job)
+
+
+def test_synthetic_null_channel_dma_and_clocked_controls():
+    j, r = synthetic()
+    assert check(j, r)
+    q = r["observations"]["queue_membership"]["records"][0]
+    t = next(t for t in j.mapped_point.task_graph.jobs if t.kind == "dma")
+    owner = next(
+        o.owner_id
+        for o in j.owners
+        if o.resource == f"dma:{t.dma_engine_id // 4}:{t.dma_engine_id % 4}"
+    )
+    q.update(queue_id=f"dma_inflight:{t.dma_engine_id}", population="inflight", owner_id=owner)
+    assert check(j, r)
+    a = r["observations"]["activities"]["records"][0]
+    q.update(
+        queue_id=f"activity:{a['subphase']}:{a['owner_id']}",
+        item_id=a["request_id"] or a["job_id"],
+        owner_id=a["owner_id"],
+        population="waiting",
+        clock_domain=a["receiving_domain"],
+        enter_ps=a["ready_ps"], leave_ps=a["start_ps"],
+        activity_id=a["activity_id"],
+    )
+    assert check(j, r)
+
+
+@pytest.mark.parametrize("domain", [None, "dram"])
+@pytest.mark.parametrize(
+    "fault", ["owner", "channel", "engine", "request", "population", "invented_queue"]
+)
+def test_synthetic_queue_attacks_restored(fault, domain):
+    j, r = synthetic()
+    assert check(j, r)
+    bad = deepcopy(r)
+    q = bad["observations"]["queue_membership"]["records"][0]
+    q["clock_domain"] = domain
+    if fault == "owner":
+        q["owner_id"] = 0
+    if fault == "channel":
+        q["queue_id"] = "channel_service:7"
+    if fault == "engine":
+        q.update(queue_id="dma_inflight:15", population="inflight")
+    if fault == "request":
+        q["item_id"] = "undeclared"
+    if fault == "population":
+        q["population"] = "inflight"
+    if fault == "invented_queue":
+        q["queue_id"] = "arbitrary"
+    with pytest.raises(ValueError, match="IncompleteObservations"):
+        check(j, bad)
+    assert check(j, r)
+
+
+def test_synthetic_activity_dispatch_and_cycle_attacks():
+    j, r = synthetic()
+    assert check(j, r)
+    for fault in ("request", "ordinal", "cycle"):
+        bad = deepcopy(r)
+        acts = bad["observations"]["activities"]["records"]
+        a = acts[0]
+        if fault == "request":
+            a["request_id"] = "undeclared"
+        if fault == "ordinal":
+            a["dispatch_ordinal"] = 999
+        if fault == "cycle":
+            a["predecessors"] = [dict(activity_id=a["activity_id"], relation="sequence")]
+        with pytest.raises(ValueError):
+            check(j, bad)
+        assert check(j, r)
+
+
+def test_stale_result_binding_precedes_queue_guard():
+    j, raw = synthetic()
+    good = check(j, raw).model_dump(mode="json")
+    bad = deepcopy(good)
+    bad["observations"]["queue_membership"]["records"][0]["item_id"] = "forged"
+    with pytest.raises(ValueError, match="ArtifactHashMismatch"):
+        validate_result(bad, j)
+    with pytest.raises(ValueError, match="IncompleteObservations"):
+        check(j, bad)
+    assert validate_result(good, j)
