# UNINSTALLED: replace only jobs.native after private access/digest verification.
native:
  needs: scope
  if: github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.scope.outputs.docs_only != 'true'
  environment: native-k1-private
  runs-on: ubuntu-24.04
  permissions:
    contents: read
  steps:
    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      with:
        persist-credentials: false
    - name: Real pinned native correctness, guarded from the hosted runner
      env:
        NATIVE_IMAGE: __OBSERVED_PRIVATE_GHCR_REPOSITORY_AT_SHA256__
        K1_TEST_PLAN: .github/native-k1-tests.json
        K1_GHCR_USER: kakoee
        K1_GHCR_READ_TOKEN: ${{ secrets.K1_GHCR_READ_TOKEN }}
      shell: bash
      run: |
        set -euo pipefail
        package="$GITHUB_WORKSPACE/docs/reviews/U4-B-final-reconciliation-v1"
        bash "$package/native-host.sh"
    - name: Preserve command statuses and receipt contents in CI logs
      if: always()
      shell: bash
      run: |
        python3 - <<'PYRECEIPTS'
        import os
        from pathlib import Path
        directory = os.environ.get("U4_RECEIPTS_DIR")
        if directory:
            for path in sorted(Path(directory).iterdir()):
                if path.is_file():
                    print(str(path), flush=True)
                    if path.suffix == ".bin":
                        import hashlib
                        print("sha256=" + hashlib.sha256(path.read_bytes()).hexdigest(), flush=True)
                    else:
                        print(path.read_text(), flush=True)
        else:
            print("No native receipt directory: pre-run setup failed or native job was skipped.")
        PYRECEIPTS
