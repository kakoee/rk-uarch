# PROPOSAL: replaces only jobs.native after release; all other CI jobs/classifier unchanged.
native:
  needs: scope
  if: needs.scope.outputs.docs_only != 'true'
  runs-on: ubuntu-24.04
  permissions:
    contents: read
  steps:
    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
    - name: Real pinned native correctness, guarded from the hosted runner
      env:
        NATIVE_IMAGE: __POST_ACCEPTANCE_FINAL_BUILDER_REPOSITORY_AT_SHA256__
        K1_TEST_PLAN: __POST_IMPLEMENTATION_REVIEWED_K1_TEST_PLAN_PATH__
      shell: bash
      run: |
        set -euo pipefail
        package="$GITHUB_WORKSPACE/docs/reviews/U4-B-final-reconciliation-v1"
        bash "$package/native-host.sh"
    - name: Preserve command statuses and receipt contents in CI logs
      if: always()
      shell: bash
      run: |
        python3 - <<'PYRECEIPTS'
        import os
        from pathlib import Path
        directory = os.environ.get("U4_RECEIPTS_DIR")
        if directory:
            for path in sorted(Path(directory).iterdir()):
                if path.is_file():
                    print(str(path), flush=True)
                    print(path.read_text(), flush=True)
        else:
            print("No native receipt directory: pre-run setup failed or native job was skipped.")
        PYRECEIPTS
