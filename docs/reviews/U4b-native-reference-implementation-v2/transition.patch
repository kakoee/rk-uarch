+    _, r = invoke(tmp_path, s)
+    assert r.counts["useful_cast"] == 4 and r.counts["useful_reduction_sum"] == 3
+    assert r.counts["hbm_read_bytes"] == 8 and r.counts["hbm_write_bytes"] == 4
