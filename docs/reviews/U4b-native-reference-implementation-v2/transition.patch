+"""Focused ordinary-process R checks with literal arithmetic and fault controls."""
+
+import json
+import os
+import subprocess
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+from uarch_contract.hashing import canonical_json, content_hash
