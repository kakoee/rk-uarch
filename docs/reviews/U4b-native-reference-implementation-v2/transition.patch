+                format="uarch-rotary-coefficients/1",
+                position_count=3,
+                rotary_dim=4,
+                dtype="fp32",
+                cos_bits=[["3f800000", "3f800000"]] * 3,
+                sin_bits=[["00000000", "00000000"]] * 3,
+                producer=dict(
+                    name="literal-test-coefficients",
+                    version="1",
+                    implementation_hash="sha256:" + "0" * 64,
+                ),
+            ),
+            "coefficients_hash",
+        )
+    )
