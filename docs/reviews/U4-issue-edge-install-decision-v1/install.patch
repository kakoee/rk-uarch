+            cause["subphase"].as_str(),
+            cause["completion_ordinal"].as_u64()
+        ),
+        (Some("r00"), Some("ack"), Some(53))
+    );
+    assert_eq!(cause["kind"], "service");
+    assert_eq!(cause["end_ps"], 86000);
+}
