+def check_reservation_opportunities(
+    rows: dict[str, Any],
+    jobs: dict[str, Any],
+    limit: int,
+    opportunities: list[Any],
+    events: list[Any],
+    job_ends: dict[str, int],
+    request_ends: dict[str, int],
+    dependencies: dict[str, list[str]],
